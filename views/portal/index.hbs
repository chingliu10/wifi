<main class="portal-app" style="--portal-brand: {{siteConfig.primary_color}};">
  <section class="portal-hero" aria-label="{{siteConfig.brand_name}}">
    <div class="hero-inner">
      <div class="hero-logo" aria-hidden="true">SG</div>
      <h1>{{siteConfig.brand_name}}</h1>
      <p>Chagua bando uunganishwe</p>
    </div>
  </section>

  <section class="purchase-card" aria-label="Nunua bando la {{siteConfig.brand_name}}">
    <form class="portal-form" id="portal-payment-form" method="POST" action="/portal/pay">
      <input type="hidden" name="deviceId" value="{{device.id}}">
      <input type="hidden" name="clientMac" value="{{device.mac_address}}">
      <input type="hidden" name="site" value="{{portal.site}}">
      <input type="hidden" name="apMac" value="{{portal.apMac}}">
      <input type="hidden" name="ssidName" value="{{portal.ssidName}}">
      <input type="hidden" name="redirectUrl" value="{{portal.redirectUrl}}">
      <input type="hidden" name="radioId" value="{{portal.radioId}}">

      <fieldset class="package-fieldset">
        <legend>
          <span class="section-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img">
              <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z"></path>
              <path d="m4 7.5 8 4.5 8-4.5M12 12v9"></path>
            </svg>
          </span>
          <span>Chagua kifurushi</span>
        </legend>

        <div class="package-grid">
          {{#each packages}}
            <label class="package-card">
              <input
                type="radio"
                name="packageId"
                value="{{id}}"
                data-price="{{price_tzs}}"
                required
              >

              <span class="package-card-body">
                <span class="package-main">
                  <span class="package-icon" aria-hidden="true">
                    {{#if @last}}
                      <svg viewBox="0 0 24 24">
                        <rect x="4" y="5.5" width="16" height="14" rx="2"></rect>
                        <path d="M8 3.5v4M16 3.5v4M4 10h16"></path>
                      </svg>
                    {{else}}
                      <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="8"></circle>
                        <path d="M12 7.5V12l3 2"></path>
                      </svg>
                    {{/if}}
                  </span>

                  <span class="package-copy">
                    <strong>{{formatPackageName name}}</strong>
                    <span>{{formatTzs price_tzs}} TZS</span>
                  </span>
                </span>

                <span class="package-radio" aria-hidden="true">
                  <span></span>
                </span>
              </span>
            </label>
          {{/each}}
        </div>

        <p class="field-help" id="package-error" role="status" hidden>Chagua kifurushi kwanza.</p>
      </fieldset>

      <div class="field">
        <label for="customer-name">
          <span class="section-icon section-icon-phone" aria-hidden="true">👤</span>
          <span>Jina la kwanza</span>
        </label>

        <input
          id="customer-name"
          name="customerName"
          type="text"
          autocomplete="given-name"
          placeholder="Mfano: Juma"
          minlength="2"
          maxlength="40"
          value="{{savedCustomer.customer_name}}"
          required
        >

        <p class="field-help" id="name-help" role="status" hidden>Weka jina lako la kwanza.</p>
      </div>

      <div class="field">
        <label for="phone-number">
          <span class="section-icon section-icon-phone" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M6.5 4.5 9 8.5 7.5 10c1 2.1 2.4 3.5 4.5 4.5l1.5-1.5 4 2.5c.5.3.7.8.6 1.4-.2 1.6-1.5 2.6-3 2.6C9.3 19.5 4.5 14.7 4.5 8.9c0-1.5 1-2.8 2.6-3 .6-.1 1.1.1 1.4.6Z"></path>
            </svg>
          </span>
          <span>Namba ya simu</span>
        </label>

        <input
          id="phone-number"
          name="phone"
          type="tel"
          inputmode="numeric"
          autocomplete="tel"
          placeholder="0655100259"
          value="{{savedCustomer.phone}}"
          minlength="10"
          maxlength="10"
          pattern="0[67][0-9]{8}"
          title="Mfano wa namba: 0655100259"
          required
        >

        <p class="phone-example" id="phone-example">
          <span aria-hidden="true">i</span>
          Mfano wa namba: 0655100259
        </p>
      </div>

      {{#if error}}
        <div class="status-box status-box-error" role="alert">{{error}}</div>
      {{/if}}

      <button class="primary-button" id="continue-button" type="submit" disabled>
        <span class="button-text">NUNUA BANDO</span>
        <span class="button-arrow" aria-hidden="true">›</span>
      </button>

      <p class="support-line">
        <span class="support-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 13v-2a8 8 0 0 1 16 0v2"></path>
            <path d="M5.5 12H8v6H6.5A2.5 2.5 0 0 1 4 15.5v-1A2.5 2.5 0 0 1 6.5 12Zm12.5 0h.5a2.5 2.5 0 0 1 2.5 2.5v1a2.5 2.5 0 0 1-2.5 2.5H16v-6h2Z"></path>
            <path d="M16 18c0 1.1-.9 2-2 2h-2"></path>
          </svg>
        </span>
        <span>Msaada / Maulizo:</span>
        <a href="tel:{{siteConfig.support_phone}}">{{siteConfig.support_phone}}</a>
      </p>
    </form>
  </section>
</main>

<div class="payment-loading" id="payment-loading" aria-live="polite" aria-hidden="true">
  <div class="payment-loading-card">
    <div class="state-spinner" aria-hidden="true"></div>
    <strong>Inatuma ombi la malipo…</strong>
    <span>Tafadhali subiri kidogo.</span>
  </div>
</div>

<script>
  (() => {
    const form = document.getElementById('portal-payment-form');
    const button = document.getElementById('continue-button');
    const buttonText = button?.querySelector('.button-text');
    const loading = document.getElementById('payment-loading');
    const customerName = document.getElementById('customer-name');
    const nameHelp = document.getElementById('name-help');
    const phone = document.getElementById('phone-number');
    const phoneExample = document.getElementById('phone-example');
    const packageError = document.getElementById('package-error');
    const packageInputs = Array.from(
      document.querySelectorAll('input[name="packageId"]')
    );
    const phonePattern = /^0[67][0-9]{8}$/;

    if (!form || !button || !buttonText || !customerName || !phone) return;

    const selectedPackage = () =>
      packageInputs.find((input) => input.checked);

    const nameIsValid = () => {
      const value = customerName.value.trim();
      return /^[A-Za-z][A-Za-z' -]{1,39}$/.test(value);
    };

    const phoneIsValid = () => phonePattern.test(phone.value.trim());

    const formatTzs = (value) =>
      Number(value || 0).toLocaleString('en-US');

    const updateButton = () => {
      const plan = selectedPackage();
      const ready = Boolean(plan && nameIsValid() && phoneIsValid());

      button.disabled = !ready;
      buttonText.textContent = plan
        ? 'LIPA ' + formatTzs(plan.dataset.price) + ' TZS'
        : 'NUNUA BANDO';
    };

    const validateName = () => {
      const valid = nameIsValid();

      customerName.setCustomValidity(
        valid || customerName.value.length === 0
          ? ''
          : 'Weka jina lako la kwanza.'
      );

      if (nameHelp) {
        nameHelp.hidden = valid || customerName.value.length === 0;
      }

      updateButton();
      return valid;
    };

    const validatePhone = () => {
      const valid = phoneIsValid();

      phone.setCustomValidity(
        valid || phone.value.length === 0
          ? ''
          : 'Mfano wa namba: 0655100259'
      );

      if (phoneExample) {
        phoneExample.classList.toggle(
          'is-warning',
          phone.value.length > 0 && !valid
        );
      }

      updateButton();
      return valid;
    };

    try {
      if (!customerName.value) {
        customerName.value = localStorage.getItem('solidusWifiCustomerName') || '';
      }

      if (!phone.value) {
        phone.value = localStorage.getItem('solidusWifiCustomerPhone') || '';
      }
    } catch (error) {
      // Captive portal browsers may block localStorage; continue without it.
    }

    customerName.addEventListener('input', () => {
      customerName.value = customerName.value
        .replace(/[^A-Za-z' -]/g, '')
        .replace(/\s{2,}/g, ' ')
        .slice(0, 40);

      validateName();
    });

    packageInputs.forEach((input) => {
      input.addEventListener('change', () => {
        if (packageError) packageError.hidden = true;
        updateButton();
      });
    });

    phone.addEventListener('input', () => {
      phone.value = phone.value.replace(/\D/g, '').slice(0, 10);
      validatePhone();
    });

    form.addEventListener('submit', (event) => {
      const plan = selectedPackage();
      const validName = validateName();
      const validPhone = validatePhone();

      if (!plan || !validName || !validPhone) {
        event.preventDefault();

        if (!plan && packageError) {
          packageError.hidden = false;
        }

        if (!validName) {
          customerName.focus();
        } else if (!validPhone) {
          phone.focus();
        }

        return;
      }

      try {
        localStorage.setItem(
          'solidusWifiCustomerName',
          customerName.value.trim()
        );
        localStorage.setItem(
          'solidusWifiCustomerPhone',
          phone.value.trim()
        );
      } catch (error) {
        // Captive portal browsers may block localStorage; DB still remembers it.
      }

      button.disabled = true;
      buttonText.textContent = 'INATUMA MALIPO…';

      if (loading) {
        loading.classList.add('is-visible');
        loading.setAttribute('aria-hidden', 'false');
      }
    });

    validateName();
    validatePhone();
    updateButton();
  })();
</script>
