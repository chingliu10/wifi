<main class="portal">
  <section class="portal-shell portal-shell-state" aria-labelledby="confirm-title">
    <header class="portal-brand portal-brand-state">
      <div class="brand-mark" aria-hidden="true">SG</div>
      <div class="brand-copy">
        <strong>Small Garden</strong>
        <span>WiFi</span>
      </div>
    </header>

    {{#if error}}
      <section class="state-card payment-state payment-state-error">
        <div class="state-icon state-icon-error" aria-hidden="true">!</div>
        <h1 id="confirm-title">{{title}}</h1>
        <p class="state-copy">{{error}}</p>

        <button class="secondary-button" type="button" onclick="history.back()">
          Rudi nyuma
        </button>
      </section>
    {{else}}
      {{#if paymentActive}}
        <section class="state-card payment-state payment-state-success">
          <div class="state-icon state-icon-success" aria-hidden="true">✓</div>
          <h1 id="confirm-title">Umeunganishwa</h1>
          <p class="state-copy">Internet yako imewashwa.</p>

          <div class="state-summary">
            <div>
              <span>Kifurushi</span>
              <strong>{{formatPackageName package.name}}</strong>
            </div>
            {{#if subscription}}
              <div>
                <span>Internet hadi</span>
                <strong>{{formatDate subscription.expires_at}}</strong>
              </div>
            {{/if}}
          </div>

          <p class="state-note">Kama internet haijaanza, zima Wi-Fi kisha washa tena mara moja.</p>
        </section>
      {{else}}
        <section class="state-card payment-state">
          {{#if paymentInitiated}}
            <div class="state-spinner" aria-hidden="true"></div>
            <h1 id="confirm-title">Angalia simu yako</h1>
            <p class="state-copy">
              Thibitisha malipo ya <strong>{{formatTzs package.price_tzs}} TZS</strong> kwenye simu yako.
            </p>

            <div class="state-summary state-summary-compact">
              <div>
                <span>Kifurushi</span>
                <strong>{{formatPackageName package.name}}</strong>
              </div>
              <div>
                <span>Namba</span>
                <strong>{{transaction.phone}}</strong>
              </div>
            </div>

            <div class="waiting-line" id="payment-waiting">
              <span class="waiting-dot" aria-hidden="true"></span>
              Tunasubiri uthibitisho wa malipo…
            </div>
          {{else}}
            <div class="state-icon state-icon-ready" aria-hidden="true">→</div>
            <h1 id="confirm-title">Tayari kulipa</h1>
            <p class="state-copy">Tuma ombi la malipo kwenda kwenye simu yako.</p>

            <div class="state-summary state-summary-compact">
              <div>
                <span>Kifurushi</span>
                <strong>{{formatPackageName package.name}}</strong>
              </div>
              <div>
                <span>Jumla</span>
                <strong>{{formatTzs package.price_tzs}} TZS</strong>
              </div>
            </div>

            {{#if showPayNow}}
              <form class="portal-action" id="pay-now-form" method="POST" action="/portal/payment/{{transaction.reference}}/initiate">
                <button class="primary-button" id="pay-now-button" type="submit">
                  <span class="button-text">TUMA OMBI LA MALIPO</span>
                  <span class="button-arrow" aria-hidden="true">→</span>
                </button>
              </form>
            {{/if}}
          {{/if}}
        </section>
      {{/if}}
    {{/if}}

    <p class="support-line">Msaada / Maulizo: <a href="tel:0655100259">0655100259</a></p>
  </section>
</main>

{{#if showPayNow}}
<script>
  (() => {
    const form = document.getElementById('pay-now-form');
    const button = document.getElementById('pay-now-button');

    if (!form || !button) return;

    form.addEventListener('submit', () => {
      button.disabled = true;
      button.querySelector('.button-text').textContent = 'INATUMA…';
    });
  })();
</script>
{{/if}}

{{#if paymentInitiated}}
<script>
  (() => {
    const reference = {{{json transaction.reference}}};
    const waiting = document.getElementById('payment-waiting');
    let stopped = false;
    let failures = 0;

    const checkStatus = async () => {
      if (stopped) return;

      try {
        const response = await fetch(
          '/api/payments/' + encodeURIComponent(reference) + '/status',
          { cache: 'no-store' }
        );

        if (!response.ok) {
          throw new Error('Status request failed');
        }

        const data = await response.json();
        failures = 0;

        if (data.status !== 'pending' || data.accessActive === true) {
          stopped = true;
          window.location.reload();
          return;
        }

        if (waiting) {
          waiting.innerHTML =
            '<span class="waiting-dot" aria-hidden="true"></span>Tunasubiri uthibitisho wa malipo…';
        }
      } catch (error) {
        failures += 1;

        if (waiting && failures >= 2) {
          waiting.innerHTML =
            '<span class="waiting-dot" aria-hidden="true"></span>Bado tunakagua malipo yako…';
        }
      }

      setTimeout(checkStatus, 4000);
    };

    setTimeout(checkStatus, 2000);
  })();
</script>
{{/if}}
