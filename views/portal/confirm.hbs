<main class="portal">
  <section class="portal-shell" aria-labelledby="confirm-title">
    <header class="portal-brand">
      <div class="brand-mark" aria-hidden="true">SG</div>
      <div>
        <strong>Small Garden</strong>
        <span>WiFi</span>
      </div>
    </header>

    {{#if error}}
      <section class="payment-state payment-state-error">
        <div class="state-icon state-icon-error" aria-hidden="true">!</div>
        <p class="eyebrow">MALIPO</p>
        <h1 id="confirm-title">{{title}}</h1>
        <div class="status-box status-box-error" role="alert">{{error}}</div>
        <button class="secondary-button" type="button" onclick="history.back()">Rudi nyuma</button>
      </section>
    {{else}}
      {{#if paymentActive}}
        <section class="payment-state payment-state-success">
          <div class="state-icon state-icon-success" aria-hidden="true">✓</div>
          <p class="eyebrow">INTERNET IMEWASHWA</p>
          <h1 id="confirm-title">Umeunganishwa</h1>
          <p class="state-copy">Malipo yamethibitishwa na kifaa hiki sasa kina internet.</p>

          <div class="receipt-card">
            <div>
              <span>Kifurushi</span>
              <strong>{{formatPackageName package.name}}</strong>
            </div>
            <div>
              <span>Ulicholipa</span>
              <strong>{{formatTzs package.price_tzs}} TZS</strong>
            </div>
            {{#if subscription}}
              <div>
                <span>Internet hadi</span>
                <strong>{{formatDate subscription.expires_at}}</strong>
              </div>
            {{/if}}
          </div>

          <div class="status-box status-box-success">{{message}}</div>
          <p class="portal-footnote">Kama internet haijaanza mara moja, zima Wi-Fi kisha washa tena mara moja.</p>
        </section>
      {{else}}
        <section class="payment-state">
          {{#if paymentInitiated}}
            <div class="state-spinner" aria-hidden="true"></div>
            <p class="eyebrow">TUNASUBIRI MALIPO</p>
            <h1 id="confirm-title">Angalia simu yako</h1>
            <p class="state-copy">Thibitisha ombi la malipo kwenye simu yako. Ukurasa huu utabadilika wenyewe baada ya malipo kuthibitishwa.</p>
          {{else}}
            <div class="state-icon state-icon-ready" aria-hidden="true">→</div>
            <p class="eyebrow">TAYARI KULIPA</p>
            <h1 id="confirm-title">Thibitisha kifurushi</h1>
            <p class="state-copy">Tutakutumia ombi la malipo kwenye namba iliyo hapa chini.</p>
          {{/if}}

          <div class="receipt-card">
            <div>
              <span>Kifurushi</span>
              <strong>{{formatPackageName package.name}}</strong>
            </div>
            <div>
              <span>Bei</span>
              <strong>{{formatTzs package.price_tzs}} TZS</strong>
            </div>
            <div>
              <span>Namba ya simu</span>
              <strong>{{transaction.phone}}</strong>
            </div>
          </div>

          {{#if showPayNow}}
            <form class="portal-action" id="pay-now-form" method="POST" action="/portal/payment/{{transaction.reference}}/initiate">
              <button class="primary-button" id="pay-now-button" type="submit">
                <span class="button-text">TUMA OMBI LA MALIPO</span>
                <span class="button-arrow" aria-hidden="true">→</span>
              </button>
            </form>
          {{/if}}

          {{#if paymentInitiated}}
            <div class="status-box status-box-waiting" id="payment-waiting">
              Tunasubiri uthibitisho wa malipo…
            </div>
          {{else}}
            <p class="portal-footnote">Hautakatwa pesa mpaka uthibitishe malipo kwenye simu yako.</p>
          {{/if}}

          <details class="technical-details">
            <summary>Maelezo ya muamala</summary>
            <dl>
              <div><dt>Namba ya muamala</dt><dd>{{transaction.reference}}</dd></div>
              <div><dt>Hali</dt><dd>{{transaction.status}}</dd></div>
            </dl>
          </details>
        </section>
      {{/if}}
    {{/if}}
  </section>
</main>

{{#if showPayNow}}
<script>
  (() => {
    const form = document.getElementById('pay-now-form');
    const button = document.getElementById('pay-now-button');

    if (!form || !button) return;

    form.addEventListener('submit', () => {
      button.disabled = true;
      button.querySelector('.button-text').textContent = 'Inatuma ombi...';
      button.querySelector('.button-arrow').textContent = '';
    });
  })();
</script>
{{/if}}

{{#if paymentInitiated}}
<script>
  (() => {
    const reference = {{{json transaction.reference}}};
    const waiting = document.getElementById('payment-waiting');
    let stopped = false;
    let failures = 0;

    const checkStatus = async () => {
      if (stopped) return;

      try {
        const response = await fetch(
          '/api/payments/' + encodeURIComponent(reference) + '/status',
          { cache: 'no-store' }
        );

        if (!response.ok) {
          throw new Error('Status request failed');
        }

        const data = await response.json();
        failures = 0;

        if (data.status !== 'pending' || data.accessActive === true) {
          stopped = true;
          window.location.reload();
          return;
        }

        if (waiting) {
          waiting.textContent = 'Tunasubiri uthibitisho wa malipo…';
        }
      } catch (error) {
        failures += 1;

        if (waiting && failures >= 2) {
          waiting.textContent = 'Bado tunakagua malipo yako… tafadhali usifunge ukurasa huu.';
        }
      }

      setTimeout(checkStatus, 4000);
    };

    setTimeout(checkStatus, 2000);
  })();
</script>
{{/if}}
