<!doctype html>
<html lang="{{language}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#0f766e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Solidus WiFi">
  <title>{{title}} · Solidus WiFi</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/pwa/solidus-wifi-192.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/pwa/solidus-wifi-192.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="auth-body">
  {{{body}}}

  <script>
    (() => {
      document.querySelectorAll('[data-admin-lang]').forEach((button) => {
        button.addEventListener('click', () => {
          const url = new URL(window.location.href);
          url.searchParams.set('lang', button.dataset.adminLang);
          window.location.assign(url.toString());
        });
      });
    })();
  </script>
  <script src="/js/pwa.js" defer></script>
</body>
</html>
