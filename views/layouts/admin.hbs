<!doctype html>
<html lang="{{language}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#0f766e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Solidus WiFi">
  <title>{{title}} · Solidus WiFi</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/pwa/solidus-wifi-192.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/pwa/solidus-wifi-192.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body
  data-show-password-label="{{t 'account.showPassword'}}"
  data-hide-password-label="{{t 'account.hidePassword'}}"
>
  <div class="admin-app">
    <button
      class="sidebar-scrim"
      id="sidebar-scrim"
      type="button"
      aria-label="{{t 'common.close'}}"
      onclick="document.body.classList.remove('sidebar-open')"
    ></button>

    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="brand-mark">S</div>
        <div>
          <strong>Solidus WiFi</strong>
          <span>{{#if isSuperAdmin}}{{t 'role.platformAdmin'}}{{else}}{{t 'role.clientPortal'}}{{/if}}</span>
        </div>
      </div>

      <details class="sidebar-account">
        <summary>
          <span class="sidebar-account-avatar" aria-hidden="true">●</span>
          <span class="sidebar-account-copy">
            <strong>{{currentUser.full_name}}</strong>
            <small>{{currentUser.username}}</small>
          </span>
          <span class="sidebar-account-chevron" aria-hidden="true">⌄</span>
        </summary>

        <div class="sidebar-account-menu">
          <a href="/admin/account/password">
            {{t 'account.changePassword'}}
          </a>

          <form method="POST" action="/admin/logout">
            <button type="submit">{{t 'account.signOut'}}</button>
          </form>
        </div>
      </details>

      {{#if selectedOrg}}
        <div class="org-card">
          <span>{{#if isSuperAdmin}}{{t 'org.currentClient'}}{{else}}{{t 'org.yourBusiness'}}{{/if}}</span>
          <strong>{{selectedOrg.name}}</strong>
        </div>
      {{/if}}

      <nav class="nav">
        <a href="/admin{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.dashboard'}}</a>
        <a href="/admin/payments{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.payments'}}</a>
        <a href="/admin/customers{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.customers'}}</a>
        <a href="/admin/live-clients{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.liveClients'}}</a>
        <a href="/admin/packages{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.packages'}}</a>
        <a href="/admin/sites{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.sites'}}</a>
        <a href="/admin/wallet{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.wallet'}}</a>
        {{#if isSuperAdmin}}
          <a href="/admin/integrations/omada{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">{{t 'nav.omada'}}</a>
        {{/if}}
      </nav>

      <div class="sidebar-footer">
        {{#if isSuperAdmin}}
          <a class="add-client-link" href="/admin/clients/new">+ {{t 'account.addClient'}}</a>
        {{/if}}

        <button
          class="pwa-sidebar-button"
          id="pwa-install-button"
          type="button"
          hidden
        >
          <span aria-hidden="true">↓</span>
          {{t 'pwa.installButton'}}
        </button>

      </div>
    </aside>

    <main class="content">
      <header class="topbar">
        <button
          class="menu-button"
          type="button"
          aria-label="Menu"
          onclick="document.body.classList.toggle('sidebar-open')"
        >☰</button>

        <div class="topbar-title">
          <p class="eyebrow">SOLIDUS WIFI</p>
          <h1>{{title}}</h1>
        </div>

        <div class="topbar-actions">
          <div class="language-switcher" aria-label="Language">
            <button type="button" class="{{#if isEnglish}}active{{/if}}" data-admin-lang="en">EN</button>
            <button type="button" class="{{#if isSwahili}}active{{/if}}" data-admin-lang="sw">SW</button>
          </div>

          {{#if isSuperAdmin}}
            {{#if organizations}}
              <form class="org-switcher" method="GET" action="/admin">
                <label for="org">{{t 'org.client'}}</label>
                <select id="org" name="org" onchange="this.form.submit()">
                  {{#each organizations}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                  {{/each}}
                </select>
              </form>
            {{/if}}
          {{/if}}
        </div>
      </header>

      {{{body}}}
    </main>
  </div>

  <aside class="pwa-install-banner" id="pwa-install-banner" hidden>
    <div class="pwa-install-copy">
      <div class="pwa-install-mark" aria-hidden="true">S</div>
      <div>
        <strong>{{t 'pwa.installTitle'}}</strong>
        <p
          id="pwa-install-text"
          data-ios-text="{{t 'pwa.installIosText'}}"
        >{{t 'pwa.installText'}}</p>
      </div>
    </div>

    <div class="pwa-install-actions">
      <button type="button" class="secondary-button" id="pwa-banner-later">
        {{t 'pwa.installLater'}}
      </button>
      <button type="button" class="pwa-install-primary" id="pwa-banner-install">
        {{t 'pwa.installNow'}}
      </button>
    </div>
  </aside>

  <script>
    (() => {
      document.querySelectorAll('[data-admin-lang]').forEach((button) => {
        button.addEventListener('click', () => {
          const url = new URL(window.location.href);
          url.searchParams.set('lang', button.dataset.adminLang);
          window.location.assign(url.toString());
        });
      });

      document.querySelectorAll('.sidebar .nav a').forEach((link) => {
        link.addEventListener('click', () => {
          document.body.classList.remove('sidebar-open');
        });
      });
    })();
  </script>
  <script src="/js/password-visibility.js" defer></script>
  <script src="/js/pwa.js" defer></script>
</body>
</html>
