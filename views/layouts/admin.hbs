<!doctype html>
<html lang="{{language}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#0f766e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Solidus WiFi">
  <title>{{title}} · Solidus WiFi</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/pwa/solidus-wifi-192.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/pwa/solidus-wifi-192.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body
  data-show-password-label="{{t 'account.showPassword'}}"
  data-hide-password-label="{{t 'account.hidePassword'}}"
>
  <div class="admin-app">
    <button
      class="sidebar-scrim"
      id="sidebar-scrim"
      type="button"
      aria-label="{{t 'common.close'}}"
      onclick="document.body.classList.remove('sidebar-open')"
    ></button>

    <aside class="sidebar" id="sidebar">
      <button
        class="sidebar-close-button"
        type="button"
        aria-label="{{t 'nav.closeMenu'}}"
        onclick="document.body.classList.remove('sidebar-open')"
      >×</button>

      <div class="brand">
        <div class="brand-mark">S</div>
        <div>
          <strong>Solidus WiFi</strong>
          <span>{{#if isSuperAdmin}}{{t 'role.platformAdmin'}}{{else}}{{t 'role.clientPortal'}}{{/if}}</span>
        </div>
      </div>

      {{#if selectedOrg}}
        <div class="org-card {{#if isSuperAdmin}}org-card-superadmin{{/if}}">
          <span>{{#if isSuperAdmin}}{{t 'org.currentClient'}}{{else}}{{t 'org.yourBusiness'}}{{/if}}</span>
          <strong>{{selectedOrg.name}}</strong>
        </div>

        {{#if isSuperAdmin}}
          {{#if organizations}}
            <form class="sidebar-org-switcher" method="GET" action="/admin">
              <label for="sidebar-org">{{t 'org.client'}}</label>
              <select id="sidebar-org" name="org" onchange="this.form.submit()">
                {{#each organizations}}
                  <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            </form>
          {{/if}}
        {{/if}}
      {{/if}}

      <nav class="nav" aria-label="{{t 'nav.navigation'}}">
        <div class="nav-group">
          <span class="nav-group-label">{{t 'nav.operations'}}</span>
          <a data-nav-path="/admin" href="/admin{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10.5V20h13v-9.5"></path><path d="M9.5 20v-6h5v6"></path></svg></span><span>{{t 'nav.dashboard'}}</span></a>
          <a data-nav-path="/admin/payments" href="/admin/payments{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><path d="M7 15h4"></path></svg></span><span>{{t 'nav.payments'}}</span></a>
          <a data-nav-path="/admin/customers" href="/admin/customers{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M3.5 19c.7-4 2.5-6 5.5-6s4.8 2 5.5 6"></path><circle cx="17.5" cy="9" r="2.5"></circle><path d="M15.5 14c2.8.2 4.4 1.8 5 5"></path></svg></span><span>{{t 'nav.customers'}}</span></a>
          <a data-nav-path="/admin/live-clients" href="/admin/live-clients{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8.5a11 11 0 0 1 16 0"></path><path d="M7.5 12a6.5 6.5 0 0 1 9 0"></path><path d="M10.5 15.5a2.5 2.5 0 0 1 3 0"></path><circle cx="12" cy="19" r="1"></circle></svg></span><span>{{t 'nav.liveClients'}}</span></a>
        </div>

        <div class="nav-group">
          <span class="nav-group-label">{{t 'nav.manage'}}</span>
          <a data-nav-path="/admin/packages" href="/admin/packages{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Z"></path><path d="M4 7v10l8 4 8-4V7"></path><path d="M12 11v10"></path></svg></span><span>{{t 'nav.packages'}}</span></a>
          {{#if selectedOrg.vouchers_enabled}}
            <a data-nav-path="/admin/vouchers" href="/admin/vouchers?org={{selectedOrg.id}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 0 6.5 10 2.5 2.5 0 0 0 4 12.5V17h16v-4.5a2.5 2.5 0 0 1 0-5V3H4v4.5Z"></path><path d="M12 6v8"></path></svg></span><span>{{t 'nav.vouchers'}}</span></a>
          {{/if}}
          <a data-nav-path="/admin/sites" href="/admin/sites{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1"></rect><rect x="13" y="13" width="7" height="7" rx="1"></rect><path d="M11 7.5h3.5A2.5 2.5 0 0 1 17 10v3"></path></svg></span><span>{{t 'nav.sites'}}</span></a>
          <a data-nav-path="/admin/wallet" href="/admin/wallet{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h14a2 2 0 0 1 2 2v9H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12"></path><path d="M16 11h5v4h-5a2 2 0 0 1 0-4Z"></path></svg></span><span>{{t 'nav.wallet'}}</span></a>
        </div>

        {{#if isSuperAdmin}}
          <div class="nav-group">
            <span class="nav-group-label">{{t 'nav.system'}}</span>
            <a data-nav-path="/admin/integrations/omada" href="/admin/integrations/omada{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M4.2 7.5a9 9 0 0 1 15.6 0"></path><path d="M7.4 10a5.5 5.5 0 0 1 9.2 0"></path><path d="M12 15v5"></path></svg></span><span>{{t 'nav.omada'}}</span></a>
          </div>
        {{/if}}
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-account-mobile">
          <div class="sidebar-account-identity">
            <span class="sidebar-account-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 19c.8-4 3-6 6.5-6s5.7 2 6.5 6"></path></svg></span>
            <div>
              <strong>{{currentUser.full_name}}</strong>
              <small>{{currentUser.username}}</small>
            </div>
          </div>
          <a href="/admin/account/password">{{t 'account.changePassword'}}</a>
          <form method="POST" action="/admin/logout">
            <button type="submit">{{t 'account.signOut'}}</button>
          </form>
        </div>

        {{#if isSuperAdmin}}
          <a class="add-client-link" href="/admin/clients/new">+ {{t 'account.addClient'}}</a>
        {{/if}}

        <button
          class="pwa-sidebar-button"
          id="pwa-install-button"
          type="button"
          hidden
        >
          <span aria-hidden="true">↓</span>
          {{t 'pwa.installButton'}}
        </button>
      </div>
    </aside>

    <main class="content">
      <header class="topbar">
        <button
          class="menu-button"
          type="button"
          aria-label="Menu"
          onclick="document.body.classList.toggle('sidebar-open')"
        >☰</button>

        <div class="topbar-title">
          <p class="eyebrow">SOLIDUS WIFI</p>
          <h1>{{title}}</h1>
        </div>

        <div class="topbar-actions">
          <div class="language-switcher" aria-label="Language">
            <button type="button" class="{{#if isEnglish}}active{{/if}}" data-admin-lang="en">EN</button>
            <button type="button" class="{{#if isSwahili}}active{{/if}}" data-admin-lang="sw">SW</button>
          </div>

          <details class="topbar-account">
            <summary
              class="topbar-account-button"
              aria-label="{{t 'account.account'}}"
              title="{{t 'account.account'}}"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="3.5"></circle>
                <path d="M5.5 19c.8-4 3-6 6.5-6s5.7 2 6.5 6"></path>
              </svg>
            </summary>

            <div class="topbar-account-menu">
              <div class="topbar-account-user">
                <strong>{{currentUser.full_name}}</strong>
                <small>{{currentUser.username}}</small>
              </div>

              <a href="/admin/account/password">
                {{t 'account.changePassword'}}
              </a>

              <form method="POST" action="/admin/logout">
                <button type="submit">{{t 'account.signOut'}}</button>
              </form>
            </div>
          </details>

          {{#if isSuperAdmin}}
            {{#if organizations}}
              <form class="org-switcher" method="GET" action="/admin">
                <label for="org">{{t 'org.client'}}</label>
                <select id="org" name="org" onchange="this.form.submit()">
                  {{#each organizations}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                  {{/each}}
                </select>
              </form>
            {{/if}}
          {{/if}}
        </div>
      </header>

      {{{body}}}
    </main>
  </div>

  <nav class="mobile-bottom-nav" aria-label="{{t 'nav.navigation'}}">
    <a data-mobile-nav-path="/admin" href="/admin{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">
      <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10.5V20h13v-9.5"></path><path d="M9.5 20v-6h5v6"></path></svg></span>
      <small>{{t 'nav.dashboard'}}</small>
    </a>
    <a data-mobile-nav-path="/admin/payments" href="/admin/payments{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">
      <span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><path d="M7 15h4"></path></svg></span>
      <small>{{t 'nav.payments'}}</small>
    </a>
    <a data-mobile-nav-path="/admin/customers" href="/admin/customers{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">
      <span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M3.5 19c.7-4 2.5-6 5.5-6s4.8 2 5.5 6"></path><circle cx="17.5" cy="9" r="2.5"></circle><path d="M15.5 14c2.8.2 4.4 1.8 5 5"></path></svg></span>
      <small>{{t 'nav.customers'}}</small>
    </a>
    <a data-mobile-nav-path="/admin/wallet" href="/admin/wallet{{#if selectedOrg}}?org={{selectedOrg.id}}{{/if}}">
      <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h14a2 2 0 0 1 2 2v9H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12"></path><path d="M16 11h5v4h-5a2 2 0 0 1 0-4Z"></path></svg></span>
      <small>{{t 'nav.walletShort'}}</small>
    </a>
    <button class="mobile-more-button" id="mobile-more-button" type="button">
      <span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.5"></circle><circle cx="12" cy="12" r="1.5"></circle><circle cx="19" cy="12" r="1.5"></circle></svg></span>
      <small>{{t 'nav.more'}}</small>
    </button>
  </nav>

  <aside class="pwa-install-banner" id="pwa-install-banner" hidden>
    <div class="pwa-install-copy">
      <div class="pwa-install-mark" aria-hidden="true">S</div>
      <div>
        <strong>{{t 'pwa.installTitle'}}</strong>
        <p
          id="pwa-install-text"
          data-ios-text="{{t 'pwa.installIosText'}}"
        >{{t 'pwa.installText'}}</p>
      </div>
    </div>

    <div class="pwa-install-actions">
      <button type="button" class="secondary-button" id="pwa-banner-later">
        {{t 'pwa.installLater'}}
      </button>
      <button type="button" class="pwa-install-primary" id="pwa-banner-install">
        {{t 'pwa.installNow'}}
      </button>
    </div>
  </aside>

  <script>
    (() => {
      document.querySelectorAll('[data-admin-lang]').forEach((button) => {
        button.addEventListener('click', () => {
          const url = new URL(window.location.href);
          url.searchParams.set('lang', button.dataset.adminLang);
          window.location.assign(url.toString());
        });
      });

      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      const pathMatches = (navPath) => {
        const normalizedNavPath = navPath.replace(/\/$/, '');
        return normalizedNavPath === '/admin'
          ? currentPath === '/admin'
          : currentPath === normalizedNavPath ||
            currentPath.startsWith(normalizedNavPath + '/');
      };

      document.querySelectorAll('.sidebar .nav a[data-nav-path]').forEach((link) => {
        if (pathMatches(link.dataset.navPath)) {
          link.classList.add('active');
          link.setAttribute('aria-current', 'page');
        }

        link.addEventListener('click', () => {
          document.body.classList.remove('sidebar-open');
        });
      });

      const primaryMobilePaths = [
        '/admin',
        '/admin/payments',
        '/admin/customers',
        '/admin/wallet'
      ];
      let primaryMobileMatch = false;

      document.querySelectorAll('[data-mobile-nav-path]').forEach((link) => {
        if (pathMatches(link.dataset.mobileNavPath)) {
          primaryMobileMatch = true;
          link.classList.add('active');
          link.setAttribute('aria-current', 'page');
        }
      });

      const moreButton = document.getElementById('mobile-more-button');
      if (moreButton) {
        if (!primaryMobileMatch && currentPath.startsWith('/admin')) {
          moreButton.classList.add('active');
        }

        moreButton.addEventListener('click', () => {
          document.body.classList.add('sidebar-open');
        });
      }


      document.querySelectorAll('.topbar-account').forEach((account) => {
        document.addEventListener('click', (event) => {
          if (!account.contains(event.target)) {
            account.removeAttribute('open');
          }
        });
      });
    })();
  </script>
  <script src="/js/password-visibility.js" defer></script>
  <script src="/js/pwa.js" defer></script>
</body>
</html>
