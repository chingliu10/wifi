<section class="page-head">
  <div>
    <h2>{{t 'vouchers.batchTitle'}} · {{batch.batch_reference}}</h2>
    <p>{{t 'vouchers.batchHint'}}</p>
  </div>

  <div class="voucher-page-actions">
    <a class="secondary-button voucher-action-link" href="/admin/vouchers?org={{selectedOrg.id}}">
      {{t 'vouchers.back'}}
    </a>
    <button type="button" class="secondary-button voucher-action-link" onclick="window.print()">
      {{t 'vouchers.print'}}
    </button>
    <a
      class="primary-link"
      href="/admin/vouchers/batches/{{batch.id}}/export.csv?org={{selectedOrg.id}}"
    >
      {{t 'vouchers.exportCsv'}}
    </a>
  </div>
</section>

{{#if created}}
  <div class="notice notice-success">
    {{t 'vouchers.generatedNotice'}}
  </div>
{{/if}}

{{#if cancelled}}
  <div class="notice notice-success">
    {{t 'vouchers.batchCancelled'}}
  </div>
{{/if}}

{{#if voucherCancelled}}
  <div class="notice notice-success">
    {{t 'vouchers.codeCancelled'}}
  </div>
{{/if}}

{{#if batch.active}}
  <form
    method="POST"
    action="/admin/vouchers/batches/{{batch.id}}/cancel"
    class="voucher-cancel-batch-form"
    onsubmit="return confirm('{{t 'vouchers.cancelBatchConfirm'}}');"
  >
    <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">
    <button type="submit" class="secondary-button">
      {{t 'vouchers.cancelBatch'}}
    </button>
  </form>
{{else}}
  <div class="notice">
    {{t 'vouchers.batchInactive'}}
  </div>
{{/if}}

<section class="voucher-batch-summary-grid">
  <article class="stat-card">
    <span>{{t 'common.site'}}</span>
    <strong>{{batch.site_name}}</strong>
  </article>

  <article class="stat-card">
    <span>{{t 'common.package'}}</span>
    <strong>{{batch.package_name_snapshot}}</strong>
    <small>{{formatTzs batch.package_price_tzs_snapshot}} TZS · {{formatDuration batch.package_duration_seconds_snapshot}}</small>
  </article>

  <article class="stat-card">
    <span>{{t 'vouchers.generated'}}</span>
    <strong>{{batch.quantity}}</strong>
  </article>

  <article class="stat-card">
    <span>{{t 'vouchers.redeemableUntil'}}</span>
    <strong>
      {{#if batch.redeemable_until}}
        {{formatDate batch.redeemable_until}}
      {{else}}
        {{t 'vouchers.never'}}
      {{/if}}
    </strong>
  </article>
</section>

<section class="panel table-panel voucher-code-panel">
  <div class="panel-head">
    <div>
      <h3>{{t 'vouchers.code'}}</h3>
      <p>{{t 'vouchers.packageTerms'}}: {{batch.package_name_snapshot}}</p>
    </div>

    <button type="button" class="voucher-copy-button" id="copy-voucher-codes">
      {{t 'vouchers.copyAll'}}
    </button>
  </div>

  <div class="table-wrap">
    <table class="responsive-table">
      <thead>
        <tr>
          <th>#</th>
          <th>{{t 'vouchers.code'}}</th>
          <th>{{t 'vouchers.status'}}</th>
          <th>{{t 'vouchers.created'}}</th>
          <th>{{t 'common.actions'}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each vouchers}}
          <tr>
            <td data-label="#">{{row_number}}</td>
            <td data-label="{{t 'vouchers.code'}}"><code class="voucher-code-value">{{code}}</code></td>
            <td data-label="{{t 'vouchers.status'}}">
              <span class="status-pill status-{{status}}">{{statusLabel status}}</span>
            </td>
            <td data-label="{{t 'vouchers.created'}}">{{formatDate created_at}}</td>
            <td data-label="{{t 'common.actions'}}">
              {{#if redeemed_mac}}
                <small>{{t 'vouchers.usedBy'}} {{redeemed_mac}}</small>
              {{/if}}

              {{#if cancellable}}
                <form
                  method="POST"
                  action="/admin/vouchers/{{id}}/cancel"
                  class="inline-action-form"
                  onsubmit="return confirm('{{t 'vouchers.cancelCodeConfirm'}}');"
                >
                  <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">
                  <input type="hidden" name="batchId" value="{{../batch.id}}">
                  <button type="submit" class="voucher-inline-danger">
                    {{t 'vouchers.cancelCode'}}
                  </button>
                </form>
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

<script>
  (() => {
    const button = document.getElementById('copy-voucher-codes');

    if (!button) return;

    button.addEventListener('click', async () => {
      const codes = Array.from(
        document.querySelectorAll('.voucher-code-value')
      ).map((node) => node.textContent.trim());

      if (!codes.length) return;

      try {
        await navigator.clipboard.writeText(codes.join('\n'));
        const original = button.textContent;
        button.textContent = '✓';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1200);
      } catch (error) {
        // Clipboard APIs may be restricted in some browsers; CSV export remains available.
      }
    });
  })();
</script>
