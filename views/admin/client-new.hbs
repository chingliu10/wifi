<section class="page-head">
  <div>
    <h2>Add a WiFi client</h2>
    <p>Create the business and its owner login. Sites and devices are added afterwards.</p>
  </div>
</section>

<section class="panel form-panel">
  <form method="POST" action="/admin/clients" class="admin-form">
    <div class="form-grid">
      <label>
        <span>Business / organisation name</span>
        <input name="organizationName" required placeholder="e.g. Mwanza Cafe">
      </label>

      <label>
        <span>Owner full name</span>
        <input name="ownerName" required placeholder="Owner / contact person">
      </label>

      <label>
        <span>Owner phone</span>
        <input name="ownerPhone" placeholder="07XXXXXXXX">
      </label>

      <label>
        <span>Owner username</span>
        <input name="ownerUsername" autocomplete="off" required placeholder="e.g. mwanzaowner">
      </label>

      <label>
        <span>Temporary password</span>
        <input name="ownerPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required placeholder="Minimum 8 characters">
      </label>

      <label>
        <span>Confirm temporary password</span>
        <input name="ownerPasswordConfirm" type="password" minlength="8" maxlength="128" autocomplete="new-password" required placeholder="Repeat password">
      </label>
    </div>

    <div class="notice">
      The client will use this username and password to sign in. After creation, add their first site, device and packages.
    </div>

    <div class="form-actions">
      <a href="/admin">Cancel</a>
      <button type="submit">Create client</button>
    </div>
  </form>
</section>
