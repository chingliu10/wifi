<section class="page-head">
  <div>
    <h2>{{t 'account.changePassword'}}</h2>
    <p>{{t 'account.securityHint'}}</p>
  </div>
</section>

<section class="panel account-security-panel">
  <div class="panel-head">
    <div>
      <h3>{{t 'account.security'}}</h3>
      <p>{{currentUser.full_name}} · {{currentUser.username}}</p>
    </div>
  </div>

  {{#if success}}
    <div class="notice notice-success" role="status">{{success}}</div>
  {{/if}}

  {{#if error}}
    <div class="notice notice-error" role="alert">{{error}}</div>
  {{/if}}

  <form method="POST" action="/admin/account/password" class="admin-form account-password-form">
    <label>
      <span>{{t 'account.currentPassword'}}</span>
      <input
        name="currentPassword"
        type="password"
        autocomplete="current-password"
        maxlength="128"
        required
      >
    </label>

    <label>
      <span>{{t 'account.newPassword'}}</span>
      <input
        name="newPassword"
        type="password"
        autocomplete="new-password"
        minlength="8"
        maxlength="128"
        required
      >
      <small>{{t 'account.passwordHint'}}</small>
    </label>

    <label>
      <span>{{t 'account.confirmPassword'}}</span>
      <input
        name="confirmPassword"
        type="password"
        autocomplete="new-password"
        minlength="8"
        maxlength="128"
        required
      >
    </label>

    <div class="form-actions">
      <button type="submit">{{t 'account.savePassword'}}</button>
    </div>
  </form>
</section>
