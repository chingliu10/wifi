<section class="page-head">
  <div>
    <h2>{{t 'live.title'}}</h2>
    <p>{{t 'live.subtitle'}}</p>
  </div>

  {{#if selectedSite}}
    <a
      class="primary-link"
      id="live-refresh"
      href="/admin/live-clients?org={{selectedOrg.id}}&siteId={{selectedSite.id}}"
    >
      {{t 'live.refresh'}}
    </a>
  {{/if}}
</section>

{{#if selectedOrg}}
  {{#if freeAccessGranted}}
    <div class="notice notice-success">{{t 'customers.freeAccessGranted'}}</div>
  {{/if}}

  {{#if siteOptions}}
    <section class="panel payment-filter-panel">
      <form method="GET" action="/admin/live-clients" class="admin-form">
        <input type="hidden" name="org" value="{{selectedOrg.id}}">

        <div class="customer-filter-grid">
          <label>
            <span>{{t 'live.site'}}</span>
            <select name="siteId" onchange="this.form.submit()">
              {{#each siteOptions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </label>
        </div>
      </form>
    </section>

    {{#if error}}
      <div class="notice live-client-error" id="live-client-error">{{error}}</div>
    {{else}}
      <div class="notice live-client-error" id="live-client-error" hidden></div>
    {{/if}}

    {{#if selectedSite}}
      <div class="live-update-strip" aria-live="polite">
        <span class="live-dot" aria-hidden="true"></span>
        <strong>{{t 'live.autoLive'}}</strong>
        <span>{{t 'live.every30Seconds'}}</span>
        <span id="live-last-updated">{{t 'live.justUpdated'}}</span>
      </div>
    {{/if}}

    <section class="panel table-panel">
      <div class="table-wrap">
        <table class="responsive-table">
          <thead>
            <tr>
              <th>{{t 'live.deviceName'}}</th>
              <th>{{t 'live.mac'}}</th>
              <th>{{t 'live.ip'}}</th>
              <th>{{t 'live.ssid'}}</th>
              <th>{{t 'live.access'}}</th>
              <th>{{t 'live.activity'}}</th>
              <th>{{t 'live.ap'}}</th>
              <th>{{t 'live.signal'}}</th>
              <th>{{t 'live.uptime'}}</th>
              <th>{{t 'customers.actions'}}</th>
            </tr>
          </thead>
          <tbody id="live-client-body">
            {{#each clients}}
              <tr
                data-live-mac="{{mac}}"
                data-download-bytes="{{download_bytes}}"
                data-upload-bytes="{{upload_bytes}}"
              >
                <td data-label="{{t 'live.deviceName'}}"><strong>{{name}}</strong></td>
                <td data-label="{{t 'live.mac'}}"><code>{{mac}}</code></td>
                <td data-label="{{t 'live.ip'}}">{{ip}}</td>
                <td data-label="{{t 'live.ssid'}}">{{ssid}}</td>
                <td data-label="{{t 'live.access'}}">
                  {{#if has_internet}}
                    <span class="status-pill live-access-internet">{{t 'live.internet'}}</span>
                  {{else}}
                    <span class="status-pill live-access-portal">{{t 'live.portalOnly'}}</span>
                  {{/if}}
                </td>
                <td data-label="{{t 'live.activity'}}">
                  {{#if activity_no_internet}}
                    <span class="status-pill live-activity-none">{{t 'live.noInternet'}}</span>
                  {{else}}
                    {{#if activity_active}}
                      <span class="status-pill live-activity-active">{{t 'live.activeTraffic'}}</span>
                    {{else}}
                      <span class="status-pill live-activity-waiting">{{t 'live.measuring'}}</span>
                    {{/if}}
                  {{/if}}
                </td>
                <td data-label="{{t 'live.ap'}}">{{ap}}</td>
                <td data-label="{{t 'live.signal'}}">{{signal}}</td>
                <td data-label="{{t 'live.uptime'}}">{{uptime}}</td>
                <td data-label="{{t 'customers.actions'}}">
                  <details class="site-support-editor">
                    <summary>{{t 'customers.grantFreeAccess'}}</summary>

                    <form
                      method="POST"
                      action="/admin/live-clients/complimentary-access"
                      class="site-support-form"
                    >
                      <input
                        type="hidden"
                        name="organizationId"
                        value="{{../selectedOrg.id}}"
                      >
                      <input
                        type="hidden"
                        name="siteId"
                        value="{{../selectedSite.id}}"
                      >
                      <input
                        type="hidden"
                        name="clientMac"
                        value="{{mac}}"
                      >

                      <label>
                        <span>{{t 'customers.duration'}}</span>
                        <select name="durationSeconds" required>
                          <option value="3600">1 hour</option>
                          <option value="25200">7 hours</option>
                          <option value="86400">24 hours</option>
                          <option value="604800">7 days</option>
                          <option value="2592000">30 days</option>
                        </select>
                      </label>

                      <label>
                        <span>{{t 'customers.reasonOptional'}}</span>
                        <input
                          name="grantNote"
                          maxlength="250"
                          placeholder="{{t 'customers.reasonPlaceholder'}}"
                        >
                      </label>

                      <button type="submit">{{t 'customers.grantAccessButton'}}</button>
                    </form>
                  </details>
                </td>
              </tr>
            {{else}}
              <tr><td colspan="10" class="empty">{{t 'live.noClients'}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{> admin-pagination pagination}}
    </section>
  {{else}}
    <section class="empty-state">
      <p>{{t 'live.notLinked'}}</p>
    </section>
  {{/if}}
{{/if}}

{{#if selectedSite}}
<script>
  (() => {
    const refreshButton = document.getElementById('live-refresh');
    const tbody = document.getElementById('live-client-body');
    const updated = document.getElementById('live-last-updated');
    const errorBox = document.getElementById('live-client-error');

    if (!tbody) return;

    const labels = {
      device: '{{#if isSwahili}}Kifaa{{else}}Device{{/if}}',
      mac: 'MAC address',
      ip: 'IP address',
      ssid: 'SSID',
      access: '{{#if isSwahili}}Ufikiaji{{else}}Access{{/if}}',
      activity: '{{#if isSwahili}}Matumizi{{else}}Activity{{/if}}',
      ap: 'Access point',
      signal: 'Signal',
      uptime: '{{#if isSwahili}}Muda uliounganishwa{{else}}Uptime{{/if}}',
      internet: '{{#if isSwahili}}Internet{{else}}Internet{{/if}}',
      portal: '{{#if isSwahili}}Portal pekee{{else}}Portal only{{/if}}',
      noInternet: '{{#if isSwahili}}Hakuna internet{{else}}No Internet{{/if}}',
      active: '{{#if isSwahili}}Inatumia data{{else}}Active traffic{{/if}}',
      idle: '{{#if isSwahili}}Haitumii data{{else}}Idle{{/if}}',
      measuring: '{{#if isSwahili}}Inapima…{{else}}Measuring…{{/if}}',
      actions: '{{#if isSwahili}}Vitendo{{else}}Actions{{/if}}',
      grant: '{{#if isSwahili}}Mpe internet bure{{else}}Grant free access{{/if}}',
      duration: '{{#if isSwahili}}Muda{{else}}Duration{{/if}}',
      reason: '{{#if isSwahili}}Sababu (si lazima){{else}}Reason (optional){{/if}}',
      grantButton: '{{#if isSwahili}}Mpe internet{{else}}Grant access{{/if}}',
      reasonPlaceholder: '{{#if isSwahili}}mf. Mfanyakazi, VIP, promosheni{{else}}e.g. Staff, VIP, promotion{{/if}}',
      noClients: '{{#if isSwahili}}Hakuna wateja waliounganishwa waliopatikana.{{else}}No connected clients found.{{/if}}',
      updated: '{{#if isSwahili}}Imesasishwa sasa{{else}}Updated just now{{/if}}',
      failed: '{{#if isSwahili}}Imeshindikana kusasisha wateja kwa sasa.{{else}}Unable to refresh live clients right now.{{/if}}'
    };

    const params = new URLSearchParams(window.location.search);
    const page = params.get('page') || '1';
    const endpoint =
      '/admin/live-clients/data?org=' +
      encodeURIComponent('{{selectedOrg.id}}') +
      '&siteId=' +
      encodeURIComponent('{{selectedSite.id}}') +
      '&page=' +
      encodeURIComponent(page);

    const selectedOrgId = '{{selectedOrg.id}}';
    const selectedSiteId = '{{selectedSite.id}}';
    const previousTraffic = new Map();
    const ACTIVITY_THRESHOLD_BYTES = 4096;

    const numberOrNull = (value) => {
      if (value === null || value === undefined || value === '') return null;
      const number = Number(value);
      return Number.isFinite(number) && number >= 0 ? number : null;
    };

    document.querySelectorAll('[data-live-mac]').forEach((row) => {
      previousTraffic.set(
        String(row.dataset.liveMac || '').toUpperCase(),
        {
          down: numberOrNull(row.dataset.downloadBytes),
          up: numberOrNull(row.dataset.uploadBytes)
        }
      );
    });

    const escapeHtml = (value) =>
      String(value ?? '—')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const getActivity = (client) => {
      if (client.access !== 'internet') {
        return 'no-internet';
      }

      const directActivity =
        (numberOrNull(client.download_activity) || 0) +
        (numberOrNull(client.upload_activity) || 0);

      if (directActivity > 0) {
        return 'active';
      }

      const key = String(client.mac || '').toUpperCase();
      const previous = previousTraffic.get(key);
      const down = numberOrNull(client.download_bytes);
      const up = numberOrNull(client.upload_bytes);

      if (
        previous &&
        down !== null &&
        up !== null &&
        previous.down !== null &&
        previous.up !== null
      ) {
        const delta =
          Math.max(0, down - previous.down) +
          Math.max(0, up - previous.up);

        return delta >= ACTIVITY_THRESHOLD_BYTES ? 'active' : 'idle';
      }

      return 'measuring';
    };

    const accessHtml = (client) =>
      client.access === 'internet'
        ? '<span class="status-pill live-access-internet">' + labels.internet + '</span>'
        : '<span class="status-pill live-access-portal">' + labels.portal + '</span>';

    const activityHtml = (state) => {
      if (state === 'no-internet') {
        return '<span class="status-pill live-activity-none">' + labels.noInternet + '</span>';
      }

      if (state === 'active') {
        return '<span class="status-pill live-activity-active">' + labels.active + '</span>';
      }

      if (state === 'idle') {
        return '<span class="status-pill live-activity-idle">' + labels.idle + '</span>';
      }

      return '<span class="status-pill live-activity-waiting">' + labels.measuring + '</span>';
    };

    const renderRows = (clients) => {
      if (!clients.length) {
        tbody.innerHTML =
          '<tr><td colspan="10" class="empty">' +
          escapeHtml(labels.noClients) +
          '</td></tr>';
        previousTraffic.clear();
        return;
      }

      const nextTraffic = new Map();

      tbody.innerHTML = clients.map((client) => {
        const activity = getActivity(client);
        const key = String(client.mac || '').toUpperCase();

        nextTraffic.set(key, {
          down: numberOrNull(client.download_bytes),
          up: numberOrNull(client.upload_bytes)
        });

        return (
          '<tr data-live-mac="' + escapeHtml(client.mac) + '">' +
            '<td data-label="' + labels.device + '"><strong>' + escapeHtml(client.name) + '</strong></td>' +
            '<td data-label="' + labels.mac + '"><code>' + escapeHtml(client.mac) + '</code></td>' +
            '<td data-label="' + labels.ip + '">' + escapeHtml(client.ip) + '</td>' +
            '<td data-label="' + labels.ssid + '">' + escapeHtml(client.ssid) + '</td>' +
            '<td data-label="' + labels.access + '">' + accessHtml(client) + '</td>' +
            '<td data-label="' + labels.activity + '">' + activityHtml(activity) + '</td>' +
            '<td data-label="' + labels.ap + '">' + escapeHtml(client.ap) + '</td>' +
            '<td data-label="' + labels.signal + '">' + escapeHtml(client.signal) + '</td>' +
            '<td data-label="' + labels.uptime + '">' + escapeHtml(client.uptime) + '</td>' +
            '<td data-label="' + labels.actions + '">' +
              '<details class="site-support-editor">' +
                '<summary>' + labels.grant + '</summary>' +
                '<form method="POST" action="/admin/live-clients/complimentary-access" class="site-support-form">' +
                  '<input type="hidden" name="organizationId" value="' + escapeHtml(selectedOrgId) + '">' +
                  '<input type="hidden" name="siteId" value="' + escapeHtml(selectedSiteId) + '">' +
                  '<input type="hidden" name="clientMac" value="' + escapeHtml(client.mac) + '">' +
                  '<label><span>' + labels.duration + '</span>' +
                    '<select name="durationSeconds" required>' +
                      '<option value="3600">1 hour</option>' +
                      '<option value="25200">7 hours</option>' +
                      '<option value="86400">24 hours</option>' +
                      '<option value="604800">7 days</option>' +
                      '<option value="2592000">30 days</option>' +
                    '</select>' +
                  '</label>' +
                  '<label><span>' + labels.reason + '</span>' +
                    '<input name="grantNote" maxlength="250" placeholder="' + escapeHtml(labels.reasonPlaceholder) + '">' +
                  '</label>' +
                  '<button type="submit">' + labels.grantButton + '</button>' +
                '</form>' +
              '</details>' +
            '</td>' +
          '</tr>'
        );
      }).join('');

      previousTraffic.clear();
      nextTraffic.forEach((value, key) => previousTraffic.set(key, value));
    };

    let refreshing = false;

    const refreshLiveClients = async () => {
      if (refreshing) return;
      refreshing = true;

      if (refreshButton) {
        refreshButton.classList.add('is-refreshing');
      }

      try {
        const response = await fetch(endpoint, {
          cache: 'no-store',
          headers: {
            Accept: 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error('Live client request failed');
        }

        const data = await response.json();

        if (!data.success || !Array.isArray(data.clients)) {
          throw new Error(data.error || 'Invalid live client response');
        }

        renderRows(data.clients);

        if (updated) {
          updated.textContent = labels.updated;
        }

        if (errorBox) {
          errorBox.hidden = true;
          errorBox.textContent = '';
        }
      } catch (error) {
        if (errorBox) {
          errorBox.textContent = labels.failed;
          errorBox.hidden = false;
        }
      } finally {
        refreshing = false;

        if (refreshButton) {
          refreshButton.classList.remove('is-refreshing');
        }
      }
    };

    refreshButton?.addEventListener('click', (event) => {
      event.preventDefault();
      refreshLiveClients();
    });

    setInterval(refreshLiveClients, 30000);
  })();
</script>
{{/if}}
