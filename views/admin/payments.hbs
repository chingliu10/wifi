<section class="page-head">
  <div>
    <h2>{{t 'payments.title'}}</h2>
    <p>{{t 'payments.subtitle'}}</p>
  </div>
</section>

{{#if selectedOrg}}
  <section class="panel payment-filter-panel">
    <form method="GET" action="/admin/payments" class="admin-form">
      <input type="hidden" name="org" value="{{selectedOrg.id}}">

      <div class="payment-filter-grid">
        <label>
          <span>{{t 'common.search'}}</span>
          <input
            type="search"
            name="search"
            value="{{filters.search}}"
            placeholder="{{t 'payments.searchPlaceholder'}}"
          >
        </label>

        <label>
          <span>{{t 'common.status'}}</span>
          <select name="status">
            {{#each statusOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>{{t 'common.site'}}</span>
          <select name="siteId">
            <option value="">{{t 'common.allSites'}}</option>
            {{#each sites}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>{{t 'common.from'}}</span>
          <input type="date" name="dateFrom" value="{{filters.dateFrom}}">
        </label>

        <label>
          <span>{{t 'common.to'}}</span>
          <input type="date" name="dateTo" value="{{filters.dateTo}}">
        </label>
      </div>

      <div class="form-actions">
        <a href="/admin/payments?org={{selectedOrg.id}}">{{t 'common.clear'}}</a>
        <button type="submit">{{t 'payments.filterButton'}}</button>
      </div>
    </form>
  </section>
{{/if}}

<section class="panel table-panel">
  <div class="table-wrap">
    <table class="responsive-table">
      <thead>
        <tr>
          <th>{{t 'common.customer'}}</th>
          <th>{{t 'common.site'}}</th>
          <th>{{t 'common.package'}}</th>
          <th>{{t 'dashboard.gross'}}</th>
          <th>{{t 'dashboard.net'}}</th>
          <th>{{t 'common.status'}}</th>
          <th>{{t 'payments.paidAt'}}</th>
          <th>{{t 'payments.started'}}</th>
          <th>{{t 'payments.reference'}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each payments}}
          <tr>
            <td data-label="{{t 'common.customer'}}"><strong>{{customer_name}}</strong><small>{{phone}}</small></td>
            <td data-label="{{t 'common.site'}}">{{site_name}}</td>
            <td data-label="{{t 'common.package'}}">{{formatPackageName package_name}}</td>
            <td data-label="{{t 'dashboard.gross'}}">{{formatTzs amount_tzs}} TZS</td>
            <td data-label="{{t 'dashboard.net'}}">
              {{#if net_amount_tzs}}
                {{formatTzs net_amount_tzs}} TZS
              {{else}}
                <span class="muted-value">—</span>
              {{/if}}
            </td>
            <td data-label="{{t 'common.status'}}"><span class="status-pill status-{{status}}">{{statusLabel status}}</span></td>
            <td data-label="{{t 'payments.paidAt'}}">
              {{#if paid_at}}
                <strong>{{formatDate paid_at}}</strong>
              {{else}}
                <span class="muted-value">—</span>
              {{/if}}
            </td>
            <td data-label="{{t 'payments.started'}}">{{formatDate created_at}}</td>
            <td data-label="{{t 'payments.reference'}}"><code>{{reference}}</code></td>
          </tr>
        {{else}}
          <tr><td colspan="9" class="empty">{{t 'payments.noMatch'}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{> admin-pagination pagination}}
</section>
