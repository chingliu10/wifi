<section class="page-head">
  <div>
    <h2>Payments</h2>
    <p>Search, filter and review customer payment activity.</p>
  </div>
</section>

{{#if selectedOrg}}
  <section class="panel payment-filter-panel">
    <form method="GET" action="/admin/payments" class="admin-form">
      <input type="hidden" name="org" value="{{selectedOrg.id}}">

      <div class="payment-filter-grid">
        <label>
          <span>Search</span>
          <input
            type="search"
            name="search"
            value="{{filters.search}}"
            placeholder="Customer, phone or reference"
          >
        </label>

        <label>
          <span>Status</span>
          <select name="status">
            {{#each statusOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>Site</span>
          <select name="siteId">
            <option value="">All sites</option>
            {{#each sites}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>From</span>
          <input type="date" name="dateFrom" value="{{filters.dateFrom}}">
        </label>

        <label>
          <span>To</span>
          <input type="date" name="dateTo" value="{{filters.dateTo}}">
        </label>
      </div>

      <div class="form-actions">
        <a href="/admin/payments?org={{selectedOrg.id}}">Clear</a>
        <button type="submit">Filter payments</button>
      </div>
    </form>
  </section>
{{/if}}

<section class="panel table-panel">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th>Site</th>
          <th>Package</th>
          <th>Gross</th>
          <th>Provider fee</th>
          <th>Net</th>
          <th>Status</th>
          <th>Paid at</th>
          <th>Started</th>
          <th>Reference</th>
        </tr>
      </thead>
      <tbody>
        {{#each payments}}
          <tr>
            <td><strong>{{customer_name}}</strong><small>{{phone}}</small></td>
            <td>{{site_name}}</td>
            <td>{{formatPackageName package_name}}</td>
            <td>{{formatTzs amount_tzs}} TZS</td>
            <td>
              {{#if gateway_fee_tzs}}
                {{formatTzs gateway_fee_tzs}} TZS
              {{else}}
                <span class="muted-value">—</span>
              {{/if}}
            </td>
            <td>
              {{#if net_amount_tzs}}
                {{formatTzs net_amount_tzs}} TZS
              {{else}}
                <span class="muted-value">—</span>
              {{/if}}
            </td>
            <td><span class="status-pill status-{{status}}">{{status}}</span></td>
            <td>
              {{#if paid_at}}
                <strong>{{formatDate paid_at}}</strong>
              {{else}}
                <span class="muted-value">—</span>
              {{/if}}
            </td>
            <td>{{formatDate created_at}}</td>
            <td><code>{{reference}}</code></td>
          </tr>
        {{else}}
          <tr><td colspan="10" class="empty">No payments match these filters.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
