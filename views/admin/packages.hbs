<section class="page-head">
  <div>
    <h2>Packages</h2>
    <p>Create the packages customers see on the captive portal.</p>
  </div>
</section>

{{#if selectedOrg}}
  {{#if sites}}
    <section class="panel form-panel">
      <div class="panel-head">
        <div>
          <h3>Add package</h3>
          <p>Packages belong to one site.</p>
        </div>
      </div>

      <form method="POST" action="/admin/packages" class="admin-form">
        <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

        <div class="form-grid">
          <label>
            <span>Site</span>
            <select name="siteId" required>
              {{#each sites}}
                <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </label>

          <label>
            <span>Package name</span>
            <input name="packageName" required placeholder="e.g. 7 Hours">
          </label>

          <label>
            <span>Price (TZS)</span>
            <input name="priceTzs" type="number" min="1" required placeholder="500">
          </label>

          <label>
            <span>Duration</span>
            <div class="duration-control">
              <input name="durationValue" type="number" min="1" step="1" required placeholder="7">
              <select name="durationUnit">
                <option value="hours">Hours</option>
                <option value="days">Days</option>
              </select>
            </div>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit">Add package</button>
        </div>
      </form>
    </section>
  {{else}}
    <div class="notice">Create a site before adding packages.</div>
  {{/if}}

  <section class="panel table-panel">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Site</th><th>Package</th><th>Duration</th><th>Price</th><th>Active</th><th></th></tr></thead>
        <tbody>
          {{#each packages}}
            <tr>
              <td>{{site_name}}</td>
              <td><strong>{{formatPackageName name}}</strong></td>
              <td>{{duration_seconds}} sec</td>
              <td>
                <form method="POST" action="/admin/packages/{{id}}" class="inline-form">
                  <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">
                  <input class="price-input" type="number" name="priceTzs" min="1" value="{{price_tzs}}" required>
              </td>
              <td><input type="checkbox" name="active" {{#if active}}checked{{/if}}></td>
              <td><button type="submit">Save</button></form></td>
            </tr>
          {{else}}
            <tr><td colspan="6" class="empty">No packages yet.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{/if}}
