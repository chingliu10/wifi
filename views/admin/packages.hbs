<section class="page-head">
  <div>
    <h2>{{t 'packages.title'}}</h2>
    <p>{{t 'packages.subtitle'}}</p>
  </div>
</section>

{{#if selectedOrg}}
  {{#if sites}}
    <section class="panel form-panel">
      <div class="panel-head">
        <div>
          <h3>{{t 'packages.add'}}</h3>
          <p>{{t 'packages.belongsToSite'}}</p>
        </div>
      </div>

      <form method="POST" action="/admin/packages" class="admin-form">
        <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

        <div class="form-grid">
          <label>
            <span>{{t 'common.site'}}</span>
            <select name="siteId" required>
              {{#each sites}}
                <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </label>

          <label>
            <span>{{t 'packages.name'}}</span>
            <input name="packageName" required maxlength="100" placeholder="{{t 'packages.namePlaceholder'}}">
          </label>

          <label>
            <span>{{t 'packages.priceTzs'}}</span>
            <input name="priceTzs" type="number" min="500" step="1" required placeholder="500">
          </label>

          <label>
            <span>{{t 'common.duration'}}</span>
            <div class="duration-control">
              <input name="durationValue" type="number" min="1" step="1" required placeholder="7">
              <select name="durationUnit">
                <option value="minutes">{{t 'common.minutes'}}</option>
                <option value="hours" selected>{{t 'common.hours'}}</option>
                <option value="days">{{t 'common.days'}}</option>
              </select>
            </div>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit">{{t 'packages.addButton'}}</button>
        </div>
      </form>
    </section>
  {{else}}
    <div class="notice">{{t 'packages.createSiteFirst'}}</div>
  {{/if}}

  <section class="panel payment-filter-panel">
    <form method="GET" action="/admin/packages" class="admin-form admin-filter-form">
      <input type="hidden" name="org" value="{{selectedOrg.id}}">

      <div class="package-filter-grid">
        <label>
          <span>{{t 'common.search'}}</span>
          <input type="search" name="search" value="{{filters.search}}" placeholder="{{t 'packages.searchPlaceholder'}}">
        </label>

        <label>
          <span>{{t 'common.site'}}</span>
          <select name="siteId">
            <option value="">{{t 'common.allSites'}}</option>
            {{#each sites}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>{{t 'common.status'}}</span>
          <select name="packageStatus">
            {{#each packageStatusOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      </div>

      <div class="form-actions">
        <a href="/admin/packages?org={{selectedOrg.id}}">{{t 'common.clear'}}</a>
        <button type="submit">{{t 'common.filter'}}</button>
      </div>
    </form>
  </section>

  <section class="panel table-panel package-table-panel">
    <div class="panel-head">
      <div>
        <h3>{{t 'packages.existing'}}</h3>
        <p>{{t 'packages.manageHint'}}</p>
      </div>
    </div>

    <div class="table-wrap">
      <table class="responsive-table">
        <thead>
          <tr>
            <th>{{t 'common.site'}}</th>
            <th>{{t 'common.package'}}</th>
            <th>{{t 'common.duration'}}</th>
            <th>{{t 'common.price'}}</th>
            <th>{{t 'common.status'}}</th>
            <th>{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each packages}}
            <tr>
              <td data-label="{{t 'common.site'}}">{{site_name}}</td>
              <td data-label="{{t 'common.package'}}"><strong>{{name}}</strong></td>
              <td data-label="{{t 'common.duration'}}">{{duration_value}} {{durationUnitLabel duration_unit}}</td>
              <td data-label="{{t 'common.price'}}">{{formatTzs price_tzs}} TZS</td>
              <td data-label="{{t 'common.status'}}">
                {{#if active}}
                  <span class="status-pill status-paid">{{t 'common.active'}}</span>
                {{else}}
                  <span class="status-pill status-expired">{{t 'common.inactive'}}</span>
                {{/if}}
              </td>
              <td data-label="{{t 'common.actions'}}">
                <div class="package-actions">
                  <button
                    type="button"
                    class="package-edit-button"
                    data-package-id="{{id}}"
                    data-package-name="{{name}}"
                    data-site-name="{{site_name}}"
                    data-price="{{price_tzs}}"
                    data-duration-value="{{duration_value}}"
                    data-duration-unit="{{duration_unit}}"
                    data-active="{{#if active}}true{{else}}false{{/if}}"
                  >
                    {{t 'common.edit'}}
                  </button>

                  <button
                    type="button"
                    class="package-delete-button"
                    data-package-id="{{id}}"
                    data-package-name="{{name}}"
                    data-site-name="{{site_name}}"
                  >
                    {{t 'common.delete'}}
                  </button>
                </div>
              </td>
            </tr>
          {{else}}
            <tr><td colspan="6" class="empty">{{t 'packages.noPackages'}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    {{> admin-pagination pagination}}
  </section>

  <div id="package-edit-backdrop" class="admin-modal-backdrop" hidden>
    <section
      class="admin-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="package-edit-title"
    >
      <div class="admin-modal-head">
        <div>
          <h3 id="package-edit-title">{{t 'packages.editTitle'}}</h3>
          <p>{{t 'packages.editHint'}}</p>
        </div>
        <button type="button" class="admin-modal-close" data-close-modal aria-label="{{t 'common.close'}}">×</button>
      </div>

      <form id="package-edit-form" method="POST" class="admin-form">
        <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

        <div class="form-grid">
          <label>
            <span>{{t 'common.site'}}</span>
            <input id="edit-package-site" type="text" readonly>
          </label>

          <label>
            <span>{{t 'packages.name'}}</span>
            <input id="edit-package-name" name="packageName" maxlength="100" required>
          </label>

          <label>
            <span>{{t 'packages.priceTzs'}}</span>
            <input id="edit-package-price" name="priceTzs" type="number" min="500" step="1" required>
          </label>

          <label>
            <span>{{t 'common.duration'}}</span>
            <div class="duration-control">
              <input
                id="edit-package-duration-value"
                name="durationValue"
                type="number"
                min="1"
                step="1"
                required
              >
              <select id="edit-package-duration-unit" name="durationUnit">
                <option value="minutes">{{t 'common.minutes'}}</option>
                <option value="hours">{{t 'common.hours'}}</option>
                <option value="days">{{t 'common.days'}}</option>
              </select>
            </div>
          </label>
        </div>

        <label class="package-active-control">
          <input id="edit-package-active" name="active" type="checkbox">
          <span>{{t 'packages.activePortal'}}</span>
        </label>

        <div class="modal-note">
          {{t 'packages.futureOnly'}}
        </div>

        <div class="form-actions admin-modal-actions">
          <button type="button" class="secondary-button" data-close-modal>{{t 'common.cancel'}}</button>
          <button type="submit">{{t 'packages.saveChanges'}}</button>
        </div>
      </form>
    </section>
  </div>

  <div id="package-delete-backdrop" class="admin-modal-backdrop" hidden>
    <section
      class="admin-modal admin-modal-small"
      role="dialog"
      aria-modal="true"
      aria-labelledby="package-delete-title"
    >
      <div class="admin-modal-head">
        <div>
          <h3 id="package-delete-title">{{t 'packages.deleteTitle'}}</h3>
          <p>{{t 'packages.deleteHint'}}</p>
        </div>
        <button type="button" class="admin-modal-close" data-close-modal aria-label="{{t 'common.close'}}">×</button>
      </div>

      <div class="delete-package-summary">
        <span id="delete-package-site"></span>
        <strong id="delete-package-name"></strong>
      </div>

      <div class="modal-note">
        {{t 'packages.historyPreserved'}}
      </div>

      <form id="package-delete-form" method="POST">
        <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">
        <div class="form-actions admin-modal-actions">
          <button type="button" class="secondary-button" data-close-modal>{{t 'common.cancel'}}</button>
          <button type="submit" class="danger-solid-button">{{t 'packages.deleteButton'}}</button>
        </div>
      </form>
    </section>
  </div>

  <script>
    (() => {
      const editBackdrop = document.getElementById('package-edit-backdrop');
      const deleteBackdrop = document.getElementById('package-delete-backdrop');
      const editForm = document.getElementById('package-edit-form');
      const deleteForm = document.getElementById('package-delete-form');

      const showModal = (backdrop) => {
        backdrop.hidden = false;
        document.body.classList.add('admin-modal-open');
      };

      const closeModal = (backdrop) => {
        backdrop.hidden = true;

        if (editBackdrop.hidden && deleteBackdrop.hidden) {
          document.body.classList.remove('admin-modal-open');
        }
      };

      document.querySelectorAll('.package-edit-button').forEach((button) => {
        button.addEventListener('click', () => {
          const packageId = button.dataset.packageId;

          editForm.action = '/admin/packages/' + encodeURIComponent(packageId);
          document.getElementById('edit-package-site').value =
            button.dataset.siteName || '';
          document.getElementById('edit-package-name').value =
            button.dataset.packageName || '';
          document.getElementById('edit-package-price').value =
            button.dataset.price || '';
          document.getElementById('edit-package-duration-value').value =
            button.dataset.durationValue || '';
          document.getElementById('edit-package-duration-unit').value =
            button.dataset.durationUnit || 'hours';
          document.getElementById('edit-package-active').checked =
            button.dataset.active === 'true';

          showModal(editBackdrop);
          setTimeout(() => {
            document.getElementById('edit-package-name').focus();
          }, 0);
        });
      });

      document.querySelectorAll('.package-delete-button').forEach((button) => {
        button.addEventListener('click', () => {
          const packageId = button.dataset.packageId;

          deleteForm.action =
            '/admin/packages/' + encodeURIComponent(packageId) + '/delete';
          document.getElementById('delete-package-site').textContent =
            button.dataset.siteName || '';
          document.getElementById('delete-package-name').textContent =
            button.dataset.packageName || '';

          showModal(deleteBackdrop);
        });
      });

      document.querySelectorAll('[data-close-modal]').forEach((button) => {
        button.addEventListener('click', () => {
          const backdrop = button.closest('.admin-modal-backdrop');

          if (backdrop) {
            closeModal(backdrop);
          }
        });
      });

      [editBackdrop, deleteBackdrop].forEach((backdrop) => {
        backdrop.addEventListener('click', (event) => {
          if (event.target === backdrop) {
            closeModal(backdrop);
          }
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') {
          return;
        }

        if (!editBackdrop.hidden) {
          closeModal(editBackdrop);
        }

        if (!deleteBackdrop.hidden) {
          closeModal(deleteBackdrop);
        }
      });
    })();
  </script>
{{/if}}
