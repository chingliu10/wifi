<section class="page-head">
  <div>
    <h2>Customers</h2>
    <p>Customer activity and payment history for this client.</p>
  </div>
</section>

<section class="panel table-panel">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th>Paid orders</th>
          <th>Total spent</th>
          <th>Latest package</th>
          <th>Latest payment</th>
          <th>First seen</th>
          <th>Last seen</th>
        </tr>
      </thead>
      <tbody>
        {{#each customers}}
          <tr>
            <td>
              <strong>{{customer_name}}</strong>
              <small>{{phone}}</small>
            </td>
            <td>{{paid_orders}}</td>
            <td>{{formatTzs total_spent}} TZS</td>
            <td>
              {{#if latest_package}}
                {{formatPackageName latest_package}}
              {{else}}
                <span class="muted-value">—</span>
              {{/if}}
            </td>
            <td>
              {{#if latest_payment_at}}
                {{formatDate latest_payment_at}}
              {{else}}
                <span class="muted-value">No successful payment</span>
              {{/if}}
            </td>
            <td>{{formatDate first_seen}}</td>
            <td>{{formatDate last_seen}}</td>
          </tr>
        {{else}}
          <tr><td colspan="7" class="empty">No customers yet.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
