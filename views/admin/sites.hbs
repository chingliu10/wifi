<section class="page-head">
  <div>
    <h2>Sites & devices</h2>
    <p>{{#if selectedOrg}}{{selectedOrg.name}}{{/if}}</p>
  </div>
</section>

{{#if selectedOrg}}
<section class="panel form-panel">
  <div class="panel-head">
    <div>
      <h3>Create site</h3>
      <p>Create the physical WiFi location first. Solidus will discover the Omada IDs automatically.</p>
    </div>
  </div>

  <form method="POST" action="/admin/sites" class="admin-form">
    <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

    <div class="form-grid">
      <label>
        <span>Site name</span>
        <input name="siteName" required placeholder="e.g. Small Garden">
      </label>

      <label>
        <span>Portal brand name</span>
        <input name="brandName" placeholder="e.g. Small Garden WiFi">
      </label>

      <label>
        <span>Support phone</span>
        <input name="supportPhone" placeholder="07XXXXXXXX">
      </label>

      <label>
        <span>Brand colour</span>
        <input name="primaryColor" value="#0B6B47" placeholder="#0B6B47">
      </label>
    </div>

    <div class="form-actions">
      <button type="submit">Create site</button>
    </div>
  </form>
</section>

<section class="site-onboarding-list">
  {{#each sites}}
    <article class="site-connect-card">
      <div class="site-connect-head">
        <div>
          <div class="site-title-row">
            <div class="site-icon">⌂</div>
            <div>
              <h3>{{name}}</h3>
              <p>{{brand_name}}</p>
            </div>
          </div>
        </div>

        {{#if omada_connected}}
          <span class="connection-badge connected">Omada connected</span>
        {{else}}
          <span class="connection-badge waiting">Waiting for Omada</span>
        {{/if}}
      </div>

      <div class="site-meta-grid">
        <div>
          <span>Devices</span>
          <strong>{{device_count}}</strong>
        </div>
        <div>
          <span>Support</span>
          <strong>{{support_phone}}</strong>
        </div>
        <div>
          <span>Omada site</span>
          <strong>{{#if external_portal_site_id}}Detected{{else}}Not detected yet{{/if}}</strong>
        </div>
      </div>

      <div class="connect-omada">
        <div class="connect-copy">
          <h4>{{#if omada_connected}}Portal URL{{else}}Connect TP-Link Omada{{/if}}</h4>
          {{#if omada_connected}}
            <p>Keep this URL configured as the site's External Portal Server.</p>
          {{else}}
            <p>Paste this URL into the Omada External Portal Server. Then connect one phone to the WiFi. Solidus will capture the Omada site ID, AP MAC and SSID automatically.</p>
          {{/if}}
        </div>

        <div class="setup-url-row">
          <input
            id="setup-url-{{id}}"
            type="text"
            readonly
            value="{{setup_url}}"
            aria-label="Omada setup URL for {{name}}"
          >
          <button
            class="copy-button"
            type="button"
            data-copy-target="setup-url-{{id}}"
          >
            Copy URL
          </button>
        </div>

        {{#unless omada_connected}}
          <ol class="setup-steps">
            <li>Open the Omada Controller for this location.</li>
            <li>Open the portal settings and choose <strong>External Portal Server</strong>.</li>
            <li>Paste the URL above and save.</li>
            <li>Connect a phone to the WiFi once.</li>
            <li>Return here. The site and AP will appear automatically.</li>
          </ol>
        {{/unless}}

        {{#if external_portal_site_id}}
          <div class="detected-id">
            <span>Detected controller site ID</span>
            <code>{{external_portal_site_id}}</code>
          </div>
        {{/if}}
      </div>
    </article>
  {{else}}
    <div class="empty-state">No sites yet. Create the first site above.</div>
  {{/each}}
</section>

<section class="panel table-panel device-table-panel">
  <div class="panel-head">
    <div>
      <h3>Detected network devices</h3>
      <p>Omada access points appear here automatically after a device reaches the captive portal.</p>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Device</th>
          <th>Site</th>
          <th>SSID</th>
          <th>AP MAC</th>
          <th>Type</th>
          <th>Last portal seen</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each devices}}
          <tr>
            <td><strong>{{name}}</strong><small>{{brand}} {{model}}</small></td>
            <td>{{site_name}}</td>
            <td>{{ssid_name}}</td>
            <td><code>{{ap_mac}}</code></td>
            <td>{{device_type}}</td>
            <td>{{#if last_seen_at}}{{formatDate last_seen_at}}{{else}}—{{/if}}</td>
            <td><span class="status-pill status-paid">{{#if active}}detected{{else}}disabled{{/if}}</span></td>
          </tr>
        {{else}}
          <tr><td colspan="7" class="empty">No access point has been detected yet.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{/if}}

<script>
  (() => {
    document.querySelectorAll('[data-copy-target]').forEach((button) => {
      button.addEventListener('click', async () => {
        const input = document.getElementById(button.dataset.copyTarget);

        if (!input) return;

        try {
          await navigator.clipboard.writeText(input.value);
          const original = button.textContent;
          button.textContent = 'Copied';
          setTimeout(() => {
            button.textContent = original;
          }, 1400);
        } catch (error) {
          input.select();
          document.execCommand('copy');
        }
      });
    });
  })();
</script>
