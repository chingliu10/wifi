<section class="page-head">
  <div>
    <h2>Sites & devices</h2>
    <p>{{#if selectedOrg}}{{selectedOrg.name}}{{/if}}</p>
  </div>
</section>

{{#if selectedOrg}}
<section class="panel form-panel">
  <div class="panel-head">
    <div>
      <h3>Create site</h3>
      <p>Create the physical WiFi location. Solidus can create the matching Omada site automatically.</p>
    </div>
  </div>

  <form method="POST" action="/admin/sites" class="admin-form">
    <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

    <div class="form-grid">
      <label>
        <span>Site name</span>
        <input name="siteName" required placeholder="e.g. Mwanza Main Branch">
      </label>

      <label>
        <span>Portal brand name</span>
        <input name="brandName" placeholder="e.g. Mwanza WiFi">
      </label>

      <label>
        <span>Support phone</span>
        <input name="supportPhone" placeholder="07XXXXXXXX">
      </label>

      <label>
        <span>Brand colour</span>
        <input name="primaryColor" value="#0B6B47" placeholder="#0B6B47">
      </label>
    </div>

    <div class="form-actions">
      <button type="submit">Create site</button>
    </div>
  </form>
</section>

<section class="site-onboarding-list">
  {{#each sites}}
    <article class="site-connect-card">
      <div class="site-connect-head">
        <div class="site-title-row">
          <div class="site-icon">⌂</div>
          <div>
            <h3>{{name}}</h3>
            <p>{{brand_name}}</p>
          </div>
        </div>

        {{#if omada_provisioned}}
          <span class="connection-badge connected">Omada site ready</span>
        {{else}}
          <span class="connection-badge waiting">Omada not provisioned</span>
        {{/if}}
      </div>

      <div class="site-meta-grid">
        <div>
          <span>Detected devices</span>
          <strong>{{device_count}}</strong>
        </div>
        <div>
          <span>Support</span>
          <strong>{{support_phone}}</strong>
        </div>
        <div>
          <span>Controller site</span>
          <strong>{{#if external_portal_site_id}}Linked{{else}}Not linked{{/if}}</strong>
        </div>
      </div>

      {{#if omada_sync_error}}
        <div class="status-box-admin error">
          Omada provisioning error: {{omada_sync_error}}
        </div>
      {{/if}}

      {{#unless omada_provisioned}}
        <div class="connect-omada">
          <div class="connect-copy">
            <h4>Step 1 — Create the Omada site</h4>
            {{#if ../omadaApiEnabled}}
              <p>Solidus will create the matching site inside the central Omada Controller and generate a device account for adoption.</p>
            {{else}}
              <p>Omada automation has not been enabled by Solidus yet. The platform administrator must connect the controller Open API first.</p>
            {{/if}}
          </div>

          {{#if ../omadaApiEnabled}}
            <form method="POST" action="/admin/sites/{{id}}/omada/provision" class="inline-action-form">
              <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">
              <button type="submit" class="primary-action-button">Provision Omada site</button>
            </form>
          {{/if}}
        </div>
      {{else}}
        <div class="onboarding-steps">
          <section class="onboarding-step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4>Use this account on the factory-reset EAP</h4>
              <p>When the EAP asks you to create its local administrator account, use these exact credentials. Solidus uses the same account to adopt the AP automatically.</p>

              {{#if credential_error}}
                <div class="status-box-admin error">{{credential_error}}</div>
              {{else}}
                <div class="credential-grid">
                  <label>
                    <span>Local EAP username</span>
                    <div class="copy-field">
                      <input id="device-user-{{id}}" readonly value="{{device_username}}">
                      <button type="button" data-copy-target="device-user-{{id}}">Copy</button>
                    </div>
                  </label>

                  <label>
                    <span>Local EAP password</span>
                    <div class="copy-field">
                      <input id="device-pass-{{id}}" readonly value="{{device_password}}">
                      <button type="button" data-copy-target="device-pass-{{id}}">Copy</button>
                    </div>
                  </label>
                </div>
              {{/if}}
            </div>
          </section>

          <section class="onboarding-step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4>Point the EAP to Solidus Omada</h4>
              <p>On the EAP: System → Controller Settings → Controller Inform URL. Paste the value below and save.</p>

              <div class="copy-field inform-field">
                <input id="inform-host-{{id}}" readonly value="{{inform_host}}">
                <button type="button" data-copy-target="inform-host-{{id}}">Copy</button>
              </div>
            </div>
          </section>

          <section class="onboarding-step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h4>Claim this AP</h4>
              <p>Enter the AP MAC printed on the device label. Solidus will wait for that exact AP to appear as Pending and then adopt it into this site automatically.</p>

              <form method="POST" action="/admin/sites/{{id}}/omada/claim" class="admin-form compact-form">
                <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">

                <div class="form-grid">
                  <label>
                    <span>AP MAC address</span>
                    <input name="apMac" required placeholder="10:5A:95:51:F0:C4">
                  </label>
                </div>

                <details class="existing-credentials">
                  <summary>I already created a different local EAP username/password</summary>
                  <p>Only use this for an AP that was configured before Solidus generated the credentials above.</p>

                  <div class="form-grid">
                    <label>
                      <span>Existing EAP username</span>
                      <input name="localUsername" autocomplete="off">
                    </label>
                    <label>
                      <span>Existing EAP password</span>
                      <input name="localPassword" type="password" autocomplete="new-password">
                    </label>
                  </div>
                </details>

                <div class="form-actions">
                  <button type="submit">Start automatic adoption</button>
                </div>
              </form>
            </div>
          </section>

          <section class="onboarding-step">
            <div class="step-number">4</div>
            <div class="step-content">
              <h4>Adoption status</h4>

              <div class="claim-list">
                {{#each claims}}
                  <div class="claim-row">
                    <div>
                      <strong>{{ap_mac}}</strong>
                      <small>Last checked: {{#if last_checked_at}}{{formatDate last_checked_at}}{{else}}waiting{{/if}}</small>
                    </div>
                    <span class="claim-status status-{{status}}">{{status}}</span>
                  </div>

                  {{#if last_error}}
                    <div class="claim-error">{{last_error}}</div>
                  {{/if}}
                {{else}}
                  <p class="muted-copy">No AP claimed yet.</p>
                {{/each}}
              </div>

              <p class="worker-note">You can leave this page. Solidus checks pending AP claims automatically in the background.</p>
            </div>
          </section>
        </div>
      {{/unless}}
    </article>
  {{else}}
    <div class="empty-state">No sites yet. Create the first site above.</div>
  {{/each}}
</section>

<section class="panel table-panel device-table-panel">
  <div class="panel-head">
    <div>
      <h3>Managed devices</h3>
      <p>APs appear here after Omada adoption completes.</p>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Device</th>
          <th>Site</th>
          <th>AP MAC</th>
          <th>Model</th>
          <th>IP</th>
          <th>Last seen</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each devices}}
          <tr>
            <td><strong>{{name}}</strong><small>{{brand}}</small></td>
            <td>{{site_name}}</td>
            <td><code>{{ap_mac}}</code></td>
            <td>{{model}}</td>
            <td>{{management_ip}}</td>
            <td>{{#if last_seen_at}}{{formatDate last_seen_at}}{{else}}—{{/if}}</td>
            <td><span class="status-pill status-paid">{{#if active}}managed{{else}}disabled{{/if}}</span></td>
          </tr>
        {{else}}
          <tr><td colspan="7" class="empty">No managed APs yet.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{/if}}

<script>
  (() => {
    document.querySelectorAll('[data-copy-target]').forEach((button) => {
      button.addEventListener('click', async () => {
        const input = document.getElementById(button.dataset.copyTarget);
        if (!input) return;

        try {
          await navigator.clipboard.writeText(input.value);
        } catch (error) {
          input.select();
          document.execCommand('copy');
        }

        const original = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => {
          button.textContent = original;
        }, 1200);
      });
    });

    const hasActiveClaim = Array.from(
      document.querySelectorAll('.claim-status')
    ).some((item) =>
      ['pending', 'discovered', 'adopting', 'failed'].includes(
        item.textContent.trim().toLowerCase()
      )
    );

    if (hasActiveClaim) {
      setTimeout(() => window.location.reload(), 10000);
    }
  })();
</script>
