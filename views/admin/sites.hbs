<section class="page-head">
  <div>
    <h2>Sites & devices</h2>
    <p>{{#if selectedOrg}}{{selectedOrg.name}}{{/if}}</p>
  </div>
</section>

{{#if selectedOrg}}
<section class="panel form-panel">
  <div class="panel-head">
    <div>
      <h3>Create site</h3>
      <p>A site is one physical WiFi location.</p>
    </div>
  </div>

  <form method="POST" action="/admin/sites" class="admin-form">
    <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

    <div class="form-grid">
      <label>
        <span>Site name</span>
        <input name="siteName" required placeholder="e.g. Small Garden">
      </label>

      <label>
        <span>Portal brand name</span>
        <input name="brandName" placeholder="e.g. Small Garden WiFi">
      </label>

      <label>
        <span>Support phone</span>
        <input name="supportPhone" placeholder="07XXXXXXXX">
      </label>

      <label>
        <span>Brand colour</span>
        <input name="primaryColor" value="#0B6B47" placeholder="#0B6B47">
      </label>

      <label>
        <span>Controller / external site ID</span>
        <input name="externalPortalSiteId" placeholder="Optional Omada site ID">
      </label>
    </div>

    <div class="form-actions">
      <button type="submit">Create site</button>
    </div>
  </form>
</section>

<section class="card-grid site-list">
  {{#each sites}}
    <article class="site-card">
      <div class="site-card-top">
        <div class="site-icon">⌂</div>
        <span class="status-pill status-paid">{{#if active}}active{{else}}disabled{{/if}}</span>
      </div>
      <h3>{{name}}</h3>
      <p>{{brand_name}}</p>
      <dl>
        <div><dt>Devices</dt><dd>{{device_count}}</dd></div>
        <div><dt>Support</dt><dd>{{support_phone}}</dd></div>
        <div><dt>Controller site ID</dt><dd>{{external_portal_site_id}}</dd></div>
      </dl>
    </article>
  {{else}}
    <div class="empty-state">No sites yet. Create the first site above.</div>
  {{/each}}
</section>

{{#if sites}}
<section class="panel device-panel">
  <div class="panel-head">
    <div>
      <h3>Register network device</h3>
      <p>Map a physical AP/router to one of this client's sites.</p>
    </div>
  </div>

  <form method="POST" action="/admin/devices" class="admin-form">
    <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

    <div class="form-grid device-form-grid">
      <label>
        <span>Site</span>
        <select name="siteId" required>
          {{#each sites}}
            <option value="{{id}}">{{name}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Device name</span>
        <input name="name" required placeholder="Main Outdoor AP">
      </label>

      <label>
        <span>Type</span>
        <select name="deviceType">
          <option value="omada">TP-Link Omada</option>
          <option value="mikrotik">MikroTik</option>
          <option value="openwrt">OpenWrt</option>
          <option value="radius">Other RADIUS device</option>
        </select>
      </label>

      <label>
        <span>AP MAC address</span>
        <input name="apMac" required placeholder="10:5A:95:51:F0:C4">
      </label>

      <label>
        <span>Brand</span>
        <input name="brand" placeholder="TP-Link">
      </label>

      <label>
        <span>Model</span>
        <input name="model" placeholder="EAP225-Outdoor">
      </label>

      <label>
        <span>NAS identifier</span>
        <input name="nasIdentifier" placeholder="small-garden-eap225">
      </label>

      <label>
        <span>Management IP</span>
        <input name="managementIp" placeholder="192.168.1.2">
      </label>
    </div>

    <div class="form-actions">
      <button type="submit">Register device</button>
    </div>
  </form>
</section>
{{/if}}

<section class="panel table-panel device-table-panel">
  <div class="panel-head">
    <div>
      <h3>Registered devices</h3>
      <p>Hardware mapped to this client.</p>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Device</th>
          <th>Site</th>
          <th>Type</th>
          <th>AP MAC</th>
          <th>Management IP</th>
          <th>NAS identifier</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each devices}}
          <tr>
            <td><strong>{{name}}</strong><small>{{brand}} {{model}}</small></td>
            <td>{{site_name}}</td>
            <td>{{device_type}}</td>
            <td><code>{{ap_mac}}</code></td>
            <td>{{management_ip}}</td>
            <td><code>{{nas_identifier}}</code></td>
            <td><span class="status-pill status-paid">{{#if active}}active{{else}}disabled{{/if}}</span></td>
            <td>
              <form method="POST" action="/admin/devices/{{id}}/delete" onsubmit="return confirm('Remove this registered device?');">
                <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">
                <button class="danger-button" type="submit">Remove</button>
              </form>
            </td>
          </tr>
        {{else}}
          <tr><td colspan="8" class="empty">No network devices registered yet.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{/if}}
