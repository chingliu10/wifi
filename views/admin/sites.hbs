<section class="page-head">
  <div>
    <h2>{{t 'sites.title'}}</h2>
    <p>{{#if selectedOrg}}{{selectedOrg.name}}{{/if}}</p>
  </div>
</section>

{{#if selectedOrg}}
<section class="panel form-panel">
  <div class="panel-head">
    <div>
      <h3>{{t 'sites.create'}}</h3>
      <p>{{t 'sites.createHint'}}</p>
    </div>
  </div>

  <form method="POST" action="/admin/sites" class="admin-form">
    <input type="hidden" name="organizationId" value="{{selectedOrg.id}}">

    <div class="form-grid">
      <label>
        <span>{{t 'sites.siteName'}}</span>
        <input name="siteName" required placeholder="e.g. Mwanza Main Branch">
      </label>

      <label>
        <span>{{t 'sites.brandName'}}</span>
        <input name="brandName" placeholder="e.g. Mwanza WiFi">
      </label>

      <label>
        <span>{{t 'sites.supportPhone'}}</span>
        <input name="supportPhone" placeholder="07XXXXXXXX">
      </label>

      <label>
        <span>{{t 'sites.brandColour'}}</span>
        <input name="primaryColor" value="#0B6B47" placeholder="#0B6B47">
      </label>
    </div>

    <div class="form-actions">
      <button type="submit">{{t 'sites.createButton'}}</button>
    </div>
  </form>
</section>

<section class="site-onboarding-list">
  {{#each sites}}
    <article class="site-connect-card">
      <div class="site-connect-head">
        <div class="site-title-row">
          <div class="site-icon">⌂</div>
          <div>
            <h3>{{name}}</h3>
            <p>{{brand_name}}</p>
          </div>
        </div>

        {{#if omada_provisioned}}
          <span class="connection-badge connected">{{t 'sites.omadaReady'}}</span>
        {{else}}
          <span class="connection-badge waiting">{{t 'sites.omadaNotReady'}}</span>
        {{/if}}
      </div>

      <div class="site-meta-grid">
        <div>
          <span>{{t 'sites.detectedDevices'}}</span>
          <strong>{{device_count}}</strong>
        </div>
        <div class="site-support-meta">
          <span>{{t 'sites.support'}}</span>
          <strong>{{support_phone}}</strong>

          <details class="site-support-editor">
            <summary>{{t 'sites.editSupport'}}</summary>

            <form
              method="POST"
              action="/admin/sites/{{id}}/support-phone"
              class="site-support-form"
            >
              <input
                type="hidden"
                name="organizationId"
                value="{{../selectedOrg.id}}"
              >

              <label>
                <span>{{t 'sites.supportNumber'}}</span>
                <input
                  name="supportPhone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  maxlength="30"
                  required
                  value="{{support_phone}}"
                  placeholder="07XXXXXXXX"
                >
              </label>

              <button type="submit">{{t 'sites.saveSupport'}}</button>
            </form>
          </details>

          {{#if support_updated}}
            <small class="site-support-success">
              {{t 'sites.supportUpdated'}}
            </small>
          {{/if}}
        </div>
        <div>
          <span>{{t 'sites.controllerSite'}}</span>
          <strong>{{#if external_portal_site_id}}{{t 'sites.linked'}}{{else}}{{t 'sites.notLinked'}}{{/if}}</strong>
        </div>
      </div>

      {{#if omada_sync_error}}
        <div class="status-box-admin error">
          {{t 'sites.provisionError'}}: {{omada_sync_error}}
        </div>
      {{/if}}

      {{#unless omada_provisioned}}
        <div class="connect-omada">
          <div class="connect-copy">
            <h4>{{t 'sites.step1Title'}}</h4>
            {{#if ../omadaApiEnabled}}
              <p>{{t 'sites.step1Auto'}}</p>
            {{else}}
              <p>{{t 'sites.step1Disabled'}}</p>
            {{/if}}
          </div>

          {{#if ../omadaApiEnabled}}
            <form method="POST" action="/admin/sites/{{id}}/omada/provision" class="inline-action-form">
              <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">
              <button type="submit" class="primary-action-button">{{t 'sites.provisionButton'}}</button>
            </form>
          {{/if}}
        </div>
      {{else}}
        <div class="onboarding-steps">
          <section class="onboarding-step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4>{{t 'sites.useAccount'}}</h4>
              <p>{{t 'sites.useAccountHint'}}</p>

              {{#if credential_error}}
                <div class="status-box-admin error">{{credential_error}}</div>
              {{else}}
                <div class="credential-grid">
                  <label>
                    <span>{{t 'sites.localUsername'}}</span>
                    <div class="copy-field">
                      <input id="device-user-{{id}}" readonly value="{{device_username}}">
                      <button type="button" data-copy-target="device-user-{{id}}">{{t 'sites.copy'}}</button>
                    </div>
                  </label>

                  <label>
                    <span>{{t 'sites.localPassword'}}</span>
                    <div class="copy-field">
                      <input id="device-pass-{{id}}" type="password" readonly value="{{device_password}}" autocomplete="off">
                      <button type="button" data-copy-target="device-pass-{{id}}">{{t 'sites.copy'}}</button>
                    </div>
                  </label>
                </div>
              {{/if}}
            </div>
          </section>

          <section class="onboarding-step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4>{{t 'sites.pointEap'}}</h4>
              <p>{{t 'sites.pointEapHint'}}</p>

              <div class="copy-field inform-field">
                <input id="inform-host-{{id}}" readonly value="{{inform_host}}">
                <button type="button" data-copy-target="inform-host-{{id}}">{{t 'sites.copy'}}</button>
              </div>
            </div>
          </section>

          <section class="onboarding-step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h4>{{t 'sites.claimAp'}}</h4>
              <p>{{t 'sites.claimApHint'}}</p>

              <form method="POST" action="/admin/sites/{{id}}/omada/claim" class="admin-form compact-form">
                <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">

                <div class="form-grid">
                  <label>
                    <span>{{t 'sites.apMacAddress'}}</span>
                    <input name="apMac" required placeholder="10:5A:95:51:F0:C4">
                  </label>
                </div>

                <details class="existing-credentials">
                  <summary>{{t 'sites.existingCredentials'}}</summary>
                  <p>{{t 'sites.existingCredentialsHint'}}</p>

                  <div class="form-grid">
                    <label>
                      <span>{{t 'sites.existingUsername'}}</span>
                      <input name="localUsername" autocomplete="off">
                    </label>
                    <label>
                      <span>{{t 'sites.existingPassword'}}</span>
                      <input name="localPassword" type="password" autocomplete="new-password">
                    </label>
                  </div>
                </details>

                <div class="form-actions">
                  <button type="submit">{{t 'sites.startAdoption'}}</button>
                </div>
              </form>
            </div>
          </section>

          <section class="onboarding-step">
            <div class="step-number">4</div>
            <div class="step-content">
              <h4>{{t 'sites.adoptionStatus'}}</h4>

              <div class="claim-list">
                {{#each claims}}
                  <div class="claim-row">
                    <div>
                      <strong>{{ap_mac}}</strong>
                      <small>{{t 'sites.lastChecked'}}: {{#if last_checked_at}}{{formatDate last_checked_at}}{{else}}{{t 'sites.waiting'}}{{/if}}</small>
                    </div>
                    <span class="claim-status status-{{status}}">{{status}}</span>
                  </div>

                  {{#if last_error}}
                    <div class="claim-error">{{last_error}}</div>
                  {{/if}}
                {{else}}
                  <p class="muted-copy">{{t 'sites.noClaim'}}</p>
                {{/each}}
              </div>

              <p class="worker-note">{{t 'sites.workerNote'}}</p>
            </div>
          </section>
        </div>

        <section class="wifi-manager">
          <div class="wifi-manager-head">
            <div>
              <h4>{{t 'sites.wifiNetworks'}}</h4>
              <p>{{t 'sites.wifiNetworksHint'}}</p>
            </div>
          </div>

          {{#if wifi_error}}
            <div class="status-box-admin error">{{wifi_error}}</div>
          {{/if}}

          {{#if radio_capabilities}}
            <div class="radio-capability-card">
              <span>{{t 'sites.detectedRadio'}}</span>
              <strong>
                {{#each radio_capabilities.labels}}
                  <span class="radio-chip">{{this}}</span>
                {{else}}
                  {{t 'sites.noRadio'}}
                {{/each}}
              </strong>
              <small>{{t 'sites.autoBandHint'}}</small>
            </div>

            {{#if radio_capabilities.bandMask}}
              <form method="POST" action="/admin/sites/{{id}}/wifi-networks" class="admin-form compact-form wifi-create-form">
                <input type="hidden" name="organizationId" value="{{../selectedOrg.id}}">

                <div class="form-grid">
                  <label>
                    <span>{{t 'sites.wifiName'}}</span>
                    <input name="ssidName" required maxlength="32" placeholder="e.g. MWANZA WIFI">
                  </label>

                  <label>
                    <span>{{t 'sites.bands'}}</span>
                    <select name="bandPreference">
                      <option value="auto">{{t 'sites.autoBands'}}</option>
                      {{#if radio_capabilities.supports24}}
                        <option value="1">2.4 GHz only</option>
                      {{/if}}
                      {{#if radio_capabilities.supports5}}
                        <option value="2">5 GHz only</option>
                      {{/if}}
                      {{#if radio_capabilities.supports24And5}}
                        <option value="3">2.4 + 5 GHz</option>
                      {{/if}}
                      {{#if radio_capabilities.supports6}}
                        <option value="4">6 GHz only</option>
                      {{/if}}
                      {{#if radio_capabilities.supports24And6}}
                        <option value="5">2.4 + 6 GHz</option>
                      {{/if}}
                      {{#if radio_capabilities.supports5And6}}
                        <option value="6">5 + 6 GHz</option>
                      {{/if}}
                      {{#if radio_capabilities.supportsAll}}
                        <option value="7">2.4 + 5 + 6 GHz</option>
                      {{/if}}
                    </select>
                  </label>
                </div>

                <div class="form-actions">
                  <button type="submit">{{t 'sites.createHotspot'}}</button>
                </div>
              </form>
            {{/if}}
          {{else}}
            <div class="radio-capability-card waiting">
              <span>{{t 'sites.radioDetection'}}</span>
              <strong>{{t 'sites.waitingAdoptedAp'}}</strong>
              <small>{{t 'sites.radioWaitHint'}}</small>
            </div>
          {{/if}}

          <div class="wifi-network-list">
            {{#each wifi_networks}}
              <div class="wifi-network-row">
                <div class="wifi-network-copy">
                  <strong>{{name}}</strong>
                  <small>{{t 'sites.wlan'}}: {{wlan_name}}</small>
                </div>

                <form method="POST" action="/admin/sites/{{site_id}}/wifi-networks/{{ssid_id}}/rename" class="wifi-rename-form">
                  <input type="hidden" name="organizationId" value="{{@root.selectedOrg.id}}">
                  <input type="hidden" name="wlanId" value="{{wlan_id}}">
                  <input name="ssidName" value="{{name}}" required maxlength="32" aria-label="WiFi network name">
                  <button type="submit">{{t 'sites.rename'}}</button>
                </form>
              </div>
            {{else}}
              <p class="muted-copy wifi-empty">{{t 'sites.noWifi'}}</p>
            {{/each}}
          </div>
        </section>
      {{/unless}}
    </article>
  {{else}}
    <div class="empty-state">{{t 'sites.noSites'}}</div>
  {{/each}}
</section>

<section class="panel payment-filter-panel device-filter-panel">
  <form method="GET" action="/admin/sites" class="admin-form">
    <input type="hidden" name="org" value="{{selectedOrg.id}}">

    <div class="device-filter-grid">
      <label>
        <span>{{t 'sites.searchDevices'}}</span>
        <input type="search" name="deviceSearch" value="{{deviceFilters.search}}" placeholder="{{t 'sites.searchDevicesPlaceholder'}}">
      </label>

      <label>
        <span>{{t 'common.site'}}</span>
        <select name="deviceSiteId">
          <option value="">{{t 'common.allSites'}}</option>
          {{#each deviceSiteOptions}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>{{t 'common.status'}}</span>
        <select name="deviceStatus">
          {{#each deviceStatusOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>

    <div class="form-actions">
      <a href="/admin/sites?org={{selectedOrg.id}}">{{t 'common.clear'}}</a>
      <button type="submit">{{t 'common.filter'}}</button>
    </div>
  </form>
</section>

<section class="panel table-panel device-table-panel">
  <div class="panel-head">
    <div>
      <h3>{{t 'sites.managedDevices'}}</h3>
      <p>{{t 'sites.devicesHint'}}</p>
    </div>
  </div>

  <div class="table-wrap">
    <table class="responsive-table">
      <thead>
        <tr>
          <th>{{t 'sites.device'}}</th>
          <th>{{t 'common.site'}}</th>
          <th>{{t 'sites.apMac'}}</th>
          <th>{{t 'sites.model'}}</th>
          <th>{{t 'sites.ip'}}</th>
          <th>{{t 'sites.lastSeen'}}</th>
          <th>{{t 'common.status'}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each devices}}
          <tr>
            <td data-label="{{t 'sites.device'}}"><strong>{{name}}</strong><small>{{brand}}</small></td>
            <td data-label="{{t 'common.site'}}">{{site_name}}</td>
            <td data-label="{{t 'sites.apMac'}}"><code>{{ap_mac}}</code></td>
            <td data-label="{{t 'sites.model'}}">{{model}}</td>
            <td data-label="{{t 'sites.ip'}}">{{management_ip}}</td>
            <td data-label="{{t 'sites.lastSeen'}}">{{#if last_seen_at}}{{formatDate last_seen_at}}{{else}}—{{/if}}</td>
            <td data-label="{{t 'common.status'}}"><span class="status-pill status-{{#if active}}paid{{else}}expired{{/if}}">{{#if active}}{{t 'sites.managed'}}{{else}}{{t 'sites.disabled'}}{{/if}}</span></td>
          </tr>
        {{else}}
          <tr><td colspan="7" class="empty">{{t 'sites.noDevices'}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{> admin-pagination devicePagination}}
</section>
{{/if}}

<script>
  (() => {
    document.querySelectorAll('[data-copy-target]').forEach((button) => {
      button.addEventListener('click', async () => {
        const input = document.getElementById(button.dataset.copyTarget);
        if (!input) return;

        try {
          await navigator.clipboard.writeText(input.value);
        } catch (error) {
          input.select();
          document.execCommand('copy');
        }

        const original = button.textContent;
        button.textContent = '{{#if isSwahili}}Imenakiliwa{{else}}Copied{{/if}}';
        setTimeout(() => {
          button.textContent = original;
        }, 1200);
      });
    });

    const hasActiveClaim = Array.from(
      document.querySelectorAll('.claim-status')
    ).some((item) =>
      ['pending', 'discovered', 'adopting', 'failed'].includes(
        item.textContent.trim().toLowerCase()
      )
    );

    if (hasActiveClaim) {
      setTimeout(() => window.location.reload(), 10000);
    }
  })();
</script>
