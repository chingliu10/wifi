<section class="page-head">
  <div>
    <h2>{{#if selectedOrg}}{{selectedOrg.name}}{{else}}{{t 'dashboard.noClient'}}{{/if}}</h2>
    <p>{{t 'dashboard.overview'}}</p>
  </div>
  {{#if isSuperAdmin}}
    <a class="primary-link" href="/admin/clients/new">{{t 'account.addClient'}}</a>
  {{/if}}
</section>

{{#if selectedOrg}}
  <section class="stats-grid">
    <article class="stat-card">
      <span>{{t 'dashboard.grossToday'}}</span>
      <strong>{{formatTzs stats.revenue_today}} TZS</strong>
      <small>{{stats.payments_today}} {{t 'dashboard.successfulPayments'}}</small>
    </article>

    <article class="stat-card">
      <span>{{t 'dashboard.activeNow'}}</span>
      <strong>{{stats.active_sessions}}</strong>
      <small>{{t 'dashboard.activeSubscriptions'}}</small>
    </article>

    <article class="stat-card">
      <span>{{t 'dashboard.customers'}}</span>
      <strong>{{stats.customers}}</strong>
      <small>{{t 'dashboard.payingDevices'}}</small>
    </article>

    <article class="stat-card">
      <span>{{t 'dashboard.availableBalance'}}</span>
      <strong>{{formatTzs stats.available_balance}} TZS</strong>
      <small>{{t 'dashboard.balanceHint'}}</small>
    </article>
  </section>

  <section class="dashboard-grid">
    <article class="panel">
      <div class="panel-head">
        <div>
          <h3>{{t 'dashboard.setupProgress'}}</h3>
          <p>{{t 'dashboard.setupHint'}}</p>
        </div>
      </div>

      <div class="checklist">
        {{#each checklist}}
          <div class="check-item {{#if done}}done{{/if}}">
            <span class="check-dot">{{#if done}}✓{{else}}○{{/if}}</span>
            <span>{{label}}</span>
          </div>
        {{/each}}
      </div>
    </article>

    <article class="panel">
      <div class="panel-head">
        <div>
          <h3>{{t 'dashboard.infrastructure'}}</h3>
          <p>{{t 'dashboard.currentFootprint'}}</p>
        </div>
      </div>

      <div class="mini-stats">
        <div><span>{{t 'dashboard.sites'}}</span><strong>{{stats.sites}}</strong></div>
        <div><span>{{t 'dashboard.routers'}}</span><strong>{{stats.devices}}</strong></div>
        <div><span>{{t 'dashboard.grossCollected'}}</span><strong>{{formatTzs stats.collected_total}} TZS</strong></div>
      </div>
    </article>
  </section>

  {{#if stats.unreconciled_payments}}
    <div class="notice">
      {{stats.unreconciled_payments}} {{t 'dashboard.unreconciled'}}
    </div>
  {{/if}}

  <section class="panel table-panel">
    <div class="panel-head">
      <div>
        <h3>{{t 'dashboard.recentPayments'}}</h3>
        <p>{{t 'dashboard.latestActivity'}}</p>
      </div>
      <a href="/admin/payments?org={{selectedOrg.id}}">{{t 'dashboard.viewAll'}}</a>
    </div>

    <div class="table-wrap">
      <table class="responsive-table">
        <thead>
          <tr>
            <th>{{t 'common.customer'}}</th>
            <th>{{t 'common.site'}}</th>
            <th>{{t 'common.package'}}</th>
            <th>{{t 'dashboard.gross'}}</th>
            <th>{{t 'dashboard.net'}}</th>
            <th>{{t 'common.status'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each recentPayments}}
            <tr>
              <td data-label="{{t 'common.customer'}}"><strong>{{customer_name}}</strong><small>{{phone}}</small></td>
              <td data-label="{{t 'common.site'}}">{{site_name}}</td>
              <td data-label="{{t 'common.package'}}">{{package_name}}</td>
              <td data-label="{{t 'dashboard.gross'}}">{{formatTzs amount_tzs}} TZS</td>
              <td data-label="{{t 'dashboard.net'}}">
                {{#if net_amount_tzs}}
                  {{formatTzs net_amount_tzs}} TZS
                {{else}}
                  <span class="muted-value">—</span>
                {{/if}}
              </td>
              <td data-label="{{t 'common.status'}}"><span class="status-pill status-{{status}}">{{statusLabel status}}</span></td>
            </tr>
          {{else}}
            <tr><td colspan="6" class="empty">{{t 'dashboard.noPayments'}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{else}}
  <section class="empty-state">
    <h2>{{t 'dashboard.createFirstClient'}}</h2>
    <p>{{t 'dashboard.createFirstClientHint'}}</p>
    <a class="primary-link" href="/admin/clients/new">{{t 'account.addClient'}}</a>
  </section>
{{/if}}
