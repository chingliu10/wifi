<main class="auth-shell">
  <section class="auth-card">
    <div class="auth-card-top">
      <div class="auth-brand">
        <div class="brand-mark">S</div>
        <div>
          <strong>Solidus WiFi</strong>
          <span>{{t 'login.management'}}</span>
        </div>
      </div>

      <div class="language-switcher" aria-label="Language">
        <button type="button" class="{{#if isEnglish}}active{{/if}}" data-admin-lang="en">EN</button>
        <button type="button" class="{{#if isSwahili}}active{{/if}}" data-admin-lang="sw">SW</button>
      </div>
    </div>

    <div class="auth-copy">
      <h1>{{t 'login.signIn'}}</h1>
      <p>{{t 'login.subtitle'}}</p>
    </div>

    {{#if error}}
      <div class="auth-error" role="alert">{{error}}</div>
    {{/if}}

    <form method="POST" action="/admin/login" class="auth-form">
      <input type="hidden" name="language" value="{{language}}">

      <label>
        <span>{{t 'login.username'}}</span>
        <input
          name="username"
          autocomplete="username"
          required
          autofocus
          value="{{username}}"
        >
      </label>

      <label>
        <span>{{t 'login.password'}}</span>
        <input
          name="password"
          type="password"
          autocomplete="current-password"
          required
        >
      </label>

      <button type="submit">{{t 'login.signIn'}}</button>
    </form>
  </section>
</main>
