DATABASE_URL=postgresql://user:password@127.0.0.1:5432/radius
PORT=3000

# Payment provider: mock | snippe
PAYMENT_PROVIDER=mock

# Snippe
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
