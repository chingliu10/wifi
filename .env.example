DATABASE_URL=postgresql://user:password@127.0.0.1:5432/radius
PORT=3000
PUBLIC_BASE_URL=https://portal.soliduslogic.co.tz

# Keep false in production. Enables mock/internal testing endpoints only.
ALLOW_DEV_ROUTES=false

# Payment provider: mock | splashpay
PAYMENT_PROVIDER=mock

# SplashPay Collections API
SPLASHPAY_BASE_URL=https://api.splashpay.co.tz/api/v1
SPLASHPAY_API_KEY=
SPLASHPAY_API_SECRET=

# Customer name is collected from the captive portal.
# SplashPay confirmed one shared/default email can be used for customers.
SPLASHPAY_CUSTOMER_EMAIL=info@soliduslogic.co.tz

# SplashPay webhook verification
SPLASHPAY_WEBHOOK_SECRET=
SPLASHPAY_WEBHOOK_SIGNATURE_HEADER=x-splashpay-signature
SPLASHPAY_WEBHOOK_TIMESTAMP_HEADER=x-splashpay-timestamp

# SplashPay Disbursements API uses the same merchant API key/secret above.
# Current Mobile Money payout fee table:
# TZS 1 - 50,000       => TZS 2,000
# TZS 50,001 - 150,000 => TZS 4,500
# TZS 150,001+         => TZS 7,500
# Proof command defaults to dry-run/name lookup and only sends money when
# --confirm SEND is explicitly provided.


# One-time super-admin bootstrap.
# Run: npm run bootstrap-admin
SUPER_ADMIN_NAME=Solidus Admin
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-this-strong-password

# Omada Controller Open API automation
# Create a Client Credentials app in:
# Global View > Settings > Platform Integration > Open API
OMADA_API_ENABLED=false
OMADA_BASE_URL=https://127.0.0.1:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# Optional. If empty, Solidus tries /api/info.
OMADA_OMADAC_ID=
# Local controller certificates are often self-signed.
OMADA_TLS_REJECT_UNAUTHORIZED=false
# What a remote EAP should enter under Controller Inform URL.
OMADA_INFORM_HOST=204.168.129.223
OMADA_DEFAULT_REGION=Tanzania
OMADA_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
OMADA_DEFAULT_SCENARIO=Hotel
OMADA_ONBOARDING_POLL_MS=15000

# Hotspot Operator used by the official Omada External Portal auth flow.
# Create it in the Omada Controller under Hotspot > Operators.
OMADA_HOTSPOT_OPERATOR_USERNAME=
OMADA_HOTSPOT_OPERATOR_PASSWORD=
# Optional override. Normally OMADA_OMADAC_ID is reused.
OMADA_HOTSPOT_CONTROLLER_ID=

# 32-byte key used to encrypt Omada device-account/adoption credentials in PostgreSQL.
# Generate on the VPS with: openssl rand -hex 32
PLATFORM_ENCRYPTION_KEY=
