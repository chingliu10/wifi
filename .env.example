DATABASE_URL=postgresql://user:password@127.0.0.1:5432/radius
PORT=3000

# Payment provider: mock | splashpay
PAYMENT_PROVIDER=mock

# SplashPay Collections API
SPLASHPAY_BASE_URL=https://api.splashpay.co.tz/api/v1
SPLASHPAY_API_KEY=
SPLASHPAY_API_SECRET=

# SplashPay Mobile Money collections require customer details.
# Configure merchant-approved values here until the captive portal
# collects these fields directly.
SPLASHPAY_CUSTOMER_NAME=
SPLASHPAY_CUSTOMER_EMAIL=
